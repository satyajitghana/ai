# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/

# agent scratch — temp working files (PDFs, extracted pages, screenshots, scripts)
/scratchpad/

# isolated worktrees for background subagents — local orchestration state, not content
/.claude/worktrees/

# media lives in Cloudflare R2, not git: `pnpm media:push` uploads it and
# records it in lib/media-map.json (lib/media.ts). Thumbnails stay committed
# because the OG routes read them at build.
/public/films/**/*.mp4
/public/films/**/*.webm
/public/films/**/*.webp
/public/films/**/*.png
/public/films/**/*.jpg
/public/articles/**/*.png
/public/articles/**/*.jpg
/public/articles/**/*.jpeg
/public/articles/**/*.webp
/public/articles/**/*.gif
/public/articles/**/*.svg
/public/articles/**/*.avif
/public/articles/**/*.mp4
/public/articles/**/*.webm
/public/articles/**/*.mov
/public/articles/**/*.m4a
/public/articles/**/*.mp3
/public/articles/**/*.wav
/public/projects/**/*.png
/public/projects/**/*.jpg
/public/projects/**/*.webp

# cf CLI cache
.cloudflare/
