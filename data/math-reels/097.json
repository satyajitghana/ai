    }
  },
  "achievement": {
    "form": "bound",
    "before": {
      "label": "Best known, Banaszczyk 2012",
      "tex": "O(\\sqrt d + \\sqrt{\\log N})",
      "note": "grows, slowly, with the number $N$ of vectors"
    },
    "after": {
      "label": "Claimed, 24 Sep 2026",
      "tex": "C\\sqrt d",
      "note": "independent of $N$; existential, $C$ not explicit"
    },
    "note": "Signs become an ordering, so the Steinitz constant is $\\Theta(\\sqrt d)$"
  },
