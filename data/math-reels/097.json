  "proof": {
    "archetype": "induction",
    "steps": [
      "Track the walk inside a carefully filtered convex body",
      "Choose each next sign so the walk stays inside it",
      "Signs then turn into a good ordering of the vectors"
    ],
    "data": {
      "levels": 5,
      "labels": [
        "first sign",
        "sign 2",
        "sign 3",
        "sign 4",
        "$\\cdots$"
      ],
