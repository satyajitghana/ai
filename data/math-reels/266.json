  "achievement": {
    "form": "status",
    "label": "Zauner's conjecture (1991)",
    "statement": [
      "N(6) = 3"
    ],
    "context": "Before: $3 \\le N(6) \\le 7$; even a complete set of 7 had not been ruled out",
    "stamp": "proved",
    "note": "The 3 rests on a floating-point search under stated arithmetic conditions"
  },
  "verify": {
    "lean": "part",
    "detail": "Lean: at most 5 bases, so no complete set of 7. Not the bound of 3",
    "ourCheck": "We compared the Lean scope with the claim; we did not build it"
  },
  "sources": [
    {
