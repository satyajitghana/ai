      "quote": "'every MUB family in C^6 has at most 5 members'"
    },
    {
      "ref": "article, Three mutually unbiased bases in dimension six",
      "quote": "joined by all 36 orange cross edges marking unbiasedness"
    }
  ],
  "plain": "Ways to measure a 6-level quantum system that tell you nothing about each other: the claim is only three exist",
  "proof": {
    "archetype": "local-to-global",
    "steps": [
      "Cover every candidate vector with small balls of phases",
      "Certify which pairs of balls could be orthogonal or unbiased",
      "Search all patterns by computer: two more bases never fit"
    ],
    "data": {
