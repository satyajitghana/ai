    "beats": [
      {
        "at": 0.15,
        "text": "Can you walk to infinity on Gaussian primes with steps of bounded length?"
      },
      {
        "at": 2.23,
        "text": "Gordon asked in 1962. Highlighted: the largest cluster in this window"
      },
      {
        "at": 4.05,
        "text": "The claim: for every step bound $D$, every cluster has at most $B_D$ primes"
      }
    ]
  },
  "achievement": {
    "form": "status",
    "label": "The Gaussian moat problem (Gordon, 1962)",
    "statement": [
      "\\forall D\\ \\exists B_D:\\ \\text{every component of } G_D \\text{ has} \\le B_D \\text{ vertices}"
    ],
    "context": "Before: moats around particular regions (Gethner–Wagon–Wick 1998) and computations",
    "stamp": "proved",
    "note": "$B_D$ is ineffective; the proof is a sieve argument on residues"
  },
  "verify": {
    "lean": "main",
    "detail": "In Lean: the uniform component bound for every real $D$, axis primes included",
    "ourCheck": "We read the Lean docs and allowed axioms; we did not build it"
  },
  "sources": [
    {
      "ref": "review 028, known_before",
      "quote": "Posed by Basil Gordon (1962 ICM; Erdos credited Gordon and Motzkin)."
    },
    {
      "ref": "review 028, known_before",
      "quote": "Gethner-Wagon-Wick (Amer. Math. Monthly 1998) constructed moats around particular regions and proved isolation results"
    },
    {
      "ref": "review 028, claim",
      "quote": "For every real D there is a finite B_D such that every connected component of the graph on Gaussian primes joining primes at distance <= D has at most B_D vertices"
    },
    {
      "ref": "review 028, claim",
      "quote": "B_D is ineffective."
    },
    {
      "ref": "review 028, caveats",
      "quote": "the proof is a finite periodic sieve obstruction proved with geometric sampling and entropy estimates"
    },
    {
      "ref": "review 028, lean",
      "quote": "main theorem formalized (GaussianMoat.fullMain: uniform component bound for every real D, axis primes and associates included)."
    },
    {
      "ref": "article, How I checked",
      "quote": "only `propext`, `Quot.sound` and `Classical.choice` for every family here"
    },
    {
      "ref": "article, How I checked",
      "quote": "I compiled nothing."
    }
  ],
  "plain": "Hop between primes on a grid with steps of bounded length: you can never walk off to infinity",
  "proof": {
    "archetype": "counting",
    "steps": [
      "Remove the multiples of a few small Gaussian primes",
      "A walk's leftovers mod those primes show only so many patterns",
      "A long walk would need more patterns than exist",
      "So every walk stays trapped in a bounded region"
    ],
    "data": {
      "boxes": 4,
      "items": 5,
      "label": "more steps than patterns",
      "boxLabel": "residue patterns mod a few primes"
    }
  },
  "voice": [
    {
      "scene": "title",
      "text": "The Gaussian moat problem."
    },
    {
      "scene": "object",
      "text": "Gaussian primes, joined when close. Can you walk to infinity with bounded steps?"
    },
    {
      "scene": "proof",
      "text": "A long walk would need more residue patterns than a few primes allow."
    },
    {
      "scene": "achievement",
      "text": "Claimed: no, every such walk stays trapped."
    },
    {
      "scene": "verify",
      "text": "Lean: main theorem."
