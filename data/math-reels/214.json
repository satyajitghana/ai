  "plain": "On a branching, tree-like network, can many endless clusters live side by side before merging into one?",
  "proof": {
    "archetype": "reduction",
    "steps": [
      "Bound the critical connection operator directly, averaging the root",
      "Show its own threshold sits strictly above $p_c$",
      "Known arguments then give many infinite clusters at once"
    ],
    "data": {
      "boxes": [
        "bounded operator at $p_c$",
        "$p_c < p_{2\\to 2}$",
        "$p_c < p_u$"
      ]
    }
  },
  "voice": [
    {
      "scene": "title",
      "text": "Two thresholds, not one."
    },
    {
      "scene": "object",
      "text": "On a tree-like graph, raise p. Many infinite clusters should appear before they merge into one."
    },
    {
      "scene": "proof",
      "text": "Bound one operator at the threshold, then push its threshold strictly higher."
    },
    {
