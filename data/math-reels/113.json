  "proof": {
    "archetype": "reduction",
    "dur": 5,
    "steps": [
      "Start from a graph where everyone knows everyone: easy to count",
      "Fade out the links the real graph lacks, a bit at a time",
      "At each stage, random samples measure how the count shrank",
      "Multiply all those small ratios to get the final count"
    ],
    "data": {
      "boxes": [
        "complete graph",
        "fade missing edges",
        "sample each ratio",
        "multiply"
      ],
      "arrow": "then"
    }
  },
  "achievement": {
    "form": "status",
    "label": "Jerrum–Sinclair's general case (1989)",
    "statement": [
      "\\hat N \\in (1 \\pm \\varepsilon)\\, \\#\\mathrm{PM}(G) \\ \\text{ w.p. } 1-\\delta"
    ],
    "context": "Before: bipartite graphs only, the permanent (Jerrum–Sinclair–Vigoda, 2004), plus dense special cases",
    "stamp": "proved",
    "note": "Polynomial, but the degree is unspecified and surely large"
  },
  "verify": {
    "lean": "main",
    "detail": "MatchingFPRAS.lean writes out the whole FPRAS definition; the face-dimension bound is not formalized",
    "ourCheck": "We did not build the Lean or referee the proof"
  },
