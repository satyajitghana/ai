  "proof": {
    "archetype": "reduction",
    "steps": [
      "Reduce any partition to finitely many linear scores",
      "Up to four active pieces: handled by known methods",
      "Five or more: a deletion estimate shows one piece can go"
    ],
    "data": {
      "boxes": [
        "any partition",
        "finitely many scores",
        "at most four pieces",
        "the propeller"
      ]
    }
  },
  "achievement": {
    "form": "status",
    "label": "Khot–Naor propeller conjecture (2009)",
    "statement": [
      "\\sum_i \\Big\\| \\int_{A_i} x \\, d\\gamma_d \\Big\\|^2 \\;\\le\\; \\frac{9}{8\\pi}"
    ],
    "context": "Before: proved in $\\mathbb{R}^3$, up to four cells (Heilman–Jagannath–Naor, 2013, computer-assisted)",
    "stamp": "proved",
    "note": "Its NP-hardness corollary rests on a separate \"Unique Games Theorem\" claim"
  },
  "verify": {
    "lean": "main",
    "detail": "In Lean: the bound for all $d, k$ and its attainment; the $\\mathbb{R}^3$ case re-proved, not assumed",
    "ourCheck": "From the paper and its Lean docs; we did not build the Lean"
  },
  "voice": [
    {
      "scene": "title",
      "text": "The Gaussian propeller."
    },
    {
      "scene": "object",
      "text": "Split a Gaussian cloud; sum each piece's squared centre. Two halves give one over pi."
    },
    {
      "scene": "proof",
      "text": "Reduce to a few pieces; with five or more, one can be deleted."
    },
    {
      "scene": "achievement",
      "text": "Claimed: three blades, nine over eight pi."
    },
    {
      "scene": "verify",
      "text": "Main theorem Lean-checked."
    }
  ],
  "sources": [
    {
      "ref": "review 096, claim",
