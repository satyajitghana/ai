    "beats": [
      {
        "at": 0.14,
        "text": "A unit vector field $v$: at each point a direction, turning in a Lipschitz way"
      },
      {
        "at": 2.43,
        "text": "Integrate $f(x - t\\,v(x))$ against $dt/t$ along the short segment at each point"
      },
      {
        "at": 4.29,
        "text": "The claim: bounded on $L^2$, uniformly in the truncation"
      }
    ]
  },
  "proof": {
    "archetype": "local-to-global",
    "steps": [
      "Split the function into frequency bands",
      "Each band gets a slightly better bound, by a phase-gain iteration",
      "A Lipschitz commutator glues the bands back together"
    ],
    "data": {
      "cols": 3,
      "rows": 2,
      "patchLabel": "frequency bands",
      "label": "glued: bounded on $L^2$"
    }
  },
  "achievement": {
    "form": "status",
    "label": "Stein's conjecture, as stated by Lacey and Li",
    "statement": [
      "\\Bigl\\| \\int_{\\varepsilon<|t|<a} f(x - t\\,v(x))\\,\\tfrac{dt}{t} \\Bigr\\|_{L^2} \\le C\\,\\|f\\|_{L^2}"
    ],
    "context": "Before: only conditionally (Lacey–Li), or for fields of one variable (Bateman–Thiele)",
    "stamp": "proved",
    "note": "Short scales only, about $1/\\mathrm{Lip}(v)$; not all scales, not Zygmund's conjecture"
  },
  "verify": {
    "lean": "main",
    "detail": "Uniform truncation, principal-value and weak-(2,2) bounds for every 1-Lipschitz unit field",
    "ourCheck": "We read the review of the statement; we did not run Comparator"
  },
  "voice": [
    {
      "scene": "title",
      "text": "Stein's conjecture for Lipschitz fields."
    },
    {
      "scene": "object",
      "text": "At each point a direction, turning smoothly. Integrate along the short segment at each point."
    },
    {
      "scene": "proof",
      "text": "Bound each frequency band, then glue the bands back with a commutator."
    },
    {
      "scene": "achievement",
      "text": "Claimed: bounded, uniformly, at short scales."
    },
    {
      "scene": "verify",
      "text": "Main theorem Lean-checked."
    }
  ],
  "sources": [
    {
      "ref": "review 083, claim",
      "quote": "Only the short-scale (reciprocal-Lipschitz) form is claimed, which is the form of Stein's conjecture as stated by Lacey-Li; the Zygmund maximal-function conjecture is not addressed."
    },
    {
      "ref": "review 083, lean",
      "quote": "main theorem formalized — ComparatorChallenges/LipschitzHilbert.lean states both `main` (exists a in (0,1/2), C>0 with uniform hard-truncation, principal-value, weak-(2,2) bounds and bounded L^2 extensions for all 1-Lipschitz unit fields)"
    },
