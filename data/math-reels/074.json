  "proof": {
    "archetype": "contradiction",
    "steps": [
      "In 3D, suppose thin tubes overlap as badly as possible",
      "That forces a rigid, unmoving stack of planes and plates",
      "Entropy gains and projections break it: no such overlap"
    ],
    "data": {
      "assume": "a worst-case tube overlap",
      "smaller": "a rigid stack of planes",
      "impossible": "it breaks"
    }
  },
  "achievement": {
    "form": "status",
    "label": "The Kakeya conjectures in three and four dimensions",
    "statement": [
      "K \\subset \\mathbb R^4 \\text{ Kakeya} \\;\\Longrightarrow\\; \\dim_H K = 4",
      "\\|K_\\delta f\\|_{L^3(S^2)} \\le C_\\epsilon\\, \\delta^{-\\epsilon} \\|f\\|_{L^3(\\mathbb R^3)}"
    ],
    "context": "Before: the 3D set conjecture by Wang and Zahl (2025); in $\\mathbb R^4$, Katz and Zahl's 3.059",
    "stamp": "proved",
