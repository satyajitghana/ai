    "beats": [
      {
        "at": 0.14,
        "text": "Quillen's poset $\\mathcal A_p(G)$: nontrivial elementary abelian $p$-subgroups, by inclusion"
      },
      {
        "at": 2.14,
        "text": "A small instance: $G = A_5$, $p = 2$. Each Klein four-group sits over its three involutions"
      },
      {
        "at": 4.14,
        "text": "Five separate pieces, so not contractible, and $A_5$ has no normal 2-subgroup"
      }
    ]
