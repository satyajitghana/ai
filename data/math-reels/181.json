  "proof": {
    "archetype": "induction",
    "steps": [
      "Pick a scale where the graph has large, well-connected pieces",
      "Merge pairs of low-degree vertices: a smaller graph",
      "Solve that one by induction, then lift its cycles back"
    ],
    "data": {
      "levels": 5,
      "base": "small graph",
      "step": "shrink, solve, lift back"
    }
