  "proof": {
    "archetype": "monotone",
    "steps": [
      "Many disjoint trees share the load across every cut",
      "Keep half the edges so every cut roughly halves too",
      "Repeat; the small losses multiply to a fixed constant",
      "What remains is one tree, thin on every cut"
    ],
    "data": {
      "floor": 0.16,
      "ylabel": "edges kept, halved each round",
      "floorLabel": "one tree"
    }
  },
  "achievement": {
    "form": "status",
    "label": "Strong thin tree conjecture (Anari–Oveis Gharan, 2015)",
    "statement": [
      "|\\delta_T(S)| \\le \\tfrac{C}{k}\\,|\\delta_G(S)| \\ \\text{ for every cut } S"
    ],
    "context": "Before: thinness $\\mathrm{poly}(\\log\\log n)/k$ (Anari–Oveis Gharan, 2015)",
    "stamp": "proved",
    "note": "Constant-factor ATSP was already known (2018); $C$ is not explicit"
  },
