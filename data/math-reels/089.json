  "proof": {
    "archetype": "local-to-global",
    "steps": [
      "Build random cuts, refining them from coarse scales to fine",
      "Local formulas glue together exactly at each scale",
      "So losses never pile up: bounded distortion overall"
    ],
    "data": {
      "cols": 3,
      "rows": 2,
      "patchLabel": "scales, coarse to fine",
      "label": "losses never pile up"
    }
  },
  "achievement": {
    "form": "bound",
    "before": {
      "label": "Best known for planar, 1999",
      "tex": "O(\\sqrt{\\log n})",
      "note": "Rao; series-parallel (treewidth 2) also bounded"
    },
    "after": {
      "label": "Claimed, 23 Sep 2026",
      "tex": "O(1)",
      "note": "any edge lengths; and $C(k)$ for treewidth below $k$"
    },
    "note": "Two cases of the GNRS conjecture (1999), not all of it; $C$ is not explicit"
  },
