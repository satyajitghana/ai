    {
      "type": "equation",
      "title": "One name, one hash",
      "text": "NID = base64(SHA1(name + suffix)[0..8])",
      "parts": [
        {
          "match": "SHA1(name + suffix)",
          "note": "hash the name with a fixed 16 bytes",
          "say": "Hash the function name with a fixed sixteen byte suffix."
        },
        {
          "match": "[0..8]",
          "note": "keep the first 8 bytes",
          "say": "Keep the first eight bytes."
        },
        {
          "match": "base64",
          "note": "write them as 11 characters",
          "say": "Write them as eleven characters. No table of names ships."
        }
      ]
    },
    {
      "type": "steps",
      "title": "What else has to change",
      "say": "A few things still differ.",
      "items": [
        {
          "text": "A tiny entry stub",
          "sub": "17 bytes",
          "say": "A tiny stub hands the game its arguments."
        },
        {
          "text": "Thread storage",
          "sub": "kept on Linux",
          "say": "Thread storage already matches on Linux. On Windows it is rewritten."
        },
        {
          "text": "System calls refused",
          "sub": "kernel library replaced",
          "say": "Raw system calls are refused. The kernel library is replaced."
        },
        {
          "text": "AMD-only instructions",
          "sub": "optional stubs",
          "say": "Instructions only AMD chips have can become stubs."
