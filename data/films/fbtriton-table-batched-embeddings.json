      "steps": [
        {
          "show": [
            "ids"
          ],
          "say": "Each sample brings lists of ids, one per feature, packed into one flat array with offsets marking each bag."
        },
        {
          "show": [
            "tab"
          ],
          "flow": [
            "ids>tab"
          ],
          "say": "Every table shares one buffer, so a single kernel gathers rows for all of them."
        },
        {
          "show": [
            "sum",
            "out"
          ],
          "flow": [
            "tab>sum",
            "sum>out"
          ],
          "say": "Each bag's rows are summed into one pooled vector. The forward is just a gather and a sum."
        }
      ]
    },
