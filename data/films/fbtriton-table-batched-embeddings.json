      "steps": [
        {
          "show": [
            "grad"
          ],
          "say": "Backward runs that in reverse. Each row that was read gets the summed gradients of every bag that read it."
        },
        {
          "show": [
            "sort",
            "runs"
          ],
          "flow": [
            "grad>sort",
            "sort>runs"
          ],
          "say": "Sorting lookups by row turns the batch into runs: one unique row, and every sample that touched it."
