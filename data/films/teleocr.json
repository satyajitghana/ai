      "punch": [
        "Never flattened.",
        "Read as polygons."
      ],
      "say": "Hi, I'm Okra! TeleOCR turns scans and photos into Markdown. Here is how it reads a crumpled page without flattening it."
    },
    {
      "type": "idea",
      "text": "Teach the model where paper bends, then read each curved region as a masked polygon crop instead of unwarping the photo.",
      "mark": "masked polygon crop",
      "say": "The idea: learn where paper bends, then read each curved region as it is."
    },
    {
      "type": "stack",
