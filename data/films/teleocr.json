      "steps": [
        {
          "show": 1,
          "highlight": [
            0
          ],
          "say": "At the bottom, a Qwen vision encoder cuts the image into fourteen pixel patches."
        },
        {
          "show": 2,
          "highlight": [
            1
          ],
          "say": "An aligner trained from scratch squeezes each two by two group of patches into one token."
        },
        {
          "show": 3,
          "highlight": [
            2
          ],
          "flow": true,
          "say": "A small Qwen decoder writes the answer. About one point two billion parameters in all."
