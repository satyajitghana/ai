    {
      "type": "title",
      "headline": "How GOFish splats a full fisheye image",
      "sub": "and gets a mesh from the same scene",
      "punch": [
        "No crop",
        "No pinhole",
        "One scene"
      ],
      "say": "Hi, I'm Tangent! A fisheye lens sees past ninety degrees, and most splatting stops short. GOFish keeps going."
    },
    {
      "type": "idea",
      "text": "The calibration, not a preset crop, decides which pixels are valid, and every Gaussian a ray can reach gets drawn.",
      "mark": "not a preset crop",
      "say": "Let the lens calibration say which pixels are valid, then draw every Gaussian a ray can reach."
    },
    {
      "type": "figure",
      "src": "/articles/gofish-fisheye-gaussian-splatting/fig1.png",
      "credit": "paper, Figure 2",
      "title": "The same view, two renderers",
      "steps": [
        {
          "focus": [
            0,
            0,
            50,
            100
          ],
          "say": "On the left, the earlier renderer stops at a ring, with tile shaped smears."
        },
        {
          "focus": [
            50,
            0,
            50,
            100
          ],
          "say": "On the right, GOFish renders to the rim."
        }
      ]
    },
    {
      "type": "compare",
      "title": "Crop versus calibration",
      "left": {
        "title": "Stock 3DGUT",
        "items": [
          "Crops at a 160° field of view",
          "Sorts by camera depth",
          "Tiles from sigma point boxes"
        ],
        "say": "The earlier renderer crops the view, sorts by depth, and picks tiles from sigma point boxes."
      },
      "right": {
        "title": "GOFish",
        "items": [
          "Calibration sets the valid pixels",
          "Sorts by distance along the ray",
          "Tile tests reject only with proof"
        ],
        "say": "GOFish takes valid pixels from the calibration, sorts along the ray, and rejects a tile only with proof."
      }
    },
    {
      "type": "equation",
      "title": "What a ray sees of one Gaussian",
      "text": "alpha = min(amax, o * exp(-d^2 / 2))",
      "parts": [
        {
          "match": "alpha",
          "note": "the opacity the pixel sees",
          "say": "Alpha, the opacity a pixel sees."
        },
        {
          "match": "min(amax",
          "note": "capped at a maximum alpha",
          "say": "Capped at a maximum."
        },
        {
          "match": "o * exp",
          "note": "the Gaussian's own opacity, fading out",
          "say": "From the Gaussian's own opacity, fading."
        },
        {
          "match": "d^2 / 2",
          "note": "distance from the ray to the Gaussian",
          "say": "By its distance from the ray."
        }
      ]
    },
