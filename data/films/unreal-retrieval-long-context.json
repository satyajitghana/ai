            "keys"
          ],
          "flow": [
            "ch>llm",
            "llm>keys"
          ],
          "say": "Each chunk runs through the frozen model alone. Hidden states from a late layer, pooled into seven vectors, are its keys."
        },
        {
          "show": [
            "q",
            "qv"
          ],
          "flow": [
            "q>llm",
            "llm>qv"
