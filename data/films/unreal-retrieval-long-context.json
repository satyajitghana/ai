    {
      "type": "steps",
      "title": "Same scorer, two scales",
      "say": "One scorer serves two jobs.",
      "items": [
        {
          "text": "Corpus: encode every chunk once",
          "sub": "store the vectors",
          "say": "For a corpus, every chunk is encoded once and stored as an index."
        },
        {
          "text": "Prompt: encode chunks on demand",
          "sub": "score, then discard",
          "say": "Inside a long prompt, chunks are encoded on the fly, scored and thrown away."
        },
        {
          "text": "Train once, on retrieval",
          "sub": "no long-context data",
          "say": "Both use the same learned vectors, trained once on Wikipedia questions."
        }
      ]
    },
    {
