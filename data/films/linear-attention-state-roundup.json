{
  "slug": "linear-attention-state-roundup",
  "kicker": "Linear attention's memory, four ways",
  "style": "calligraphy",
  "palette": "emerald",
  "thumb": { "scene": 3 },
  "mascot": {
    "species": "fish",
    "name": "Brisket",
    "fur": "mint",
    "ears": "up",
    "hat": "crown",
    "glasses": "round",
    "outfit": "cape",
    "prop": "none",
    "patch": "belly",
    "accent": "#7A3E9D"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "What should a fixed-size memory hold?",
      "sub": "Four answers: SwiLA, triadic states, NHA and Spotlight",
      "punch": [
        "One matrix.",
        "Four edits."
      ],
      "say": "Hi, I'm Brisket! Linear attention keeps one fixed matrix as memory. Four designs ask what it should hold."
    },
    {
      "type": "idea",
      "text": "A linear-attention layer is an online regressor over past keys and values. Each answer edits a different part of that regressor.",
      "mark": "online regressor",
      "say": "The layer is a regressor: it fits past keys to values, then answers queries with the fit."
    },
    {
      "type": "equation",
      "title": "DeltaNet: one gradient step per token",
      "text": "S += beta (v - S k) k^T",
      "say": "DeltaNet writes back the gap between each value and its prediction. The matrix never grows.",
      "parts": [
        {
          "match": "(v - S k)",
          "note": "the prediction error"
        },
        {
          "match": "k^T",
          "note": "written along the key"
        }
      ]
    },
    {
      "type": "diagram",
      "title": "SwiLA: switch among J linear maps",
      "nodes": [
        {
          "id": "kv",
          "label": "Key and value",
          "kind": "doc",
          "at": [
            8,
            18
          ]
        },
        {
          "id": "route",
          "label": "weigh",
          "kind": "op",
          "at": [
            36,
            18
          ]
        },
        {
          "id": "maps",
          "label": "J linear maps",
          "sub": "delta steps",
          "kind": "stack",
          "at": [
            68,
            18
          ]
        },
        {
          "id": "q",
          "label": "Query prior",
          "kind": "box",
          "at": [
            24,
            84
          ]
        },
        {
          "id": "out",
          "label": "Output",
          "kind": "pill",
          "at": [
            68,
            84
          ]
        }
      ],
      "edges": [
        {
          "from": "kv",
          "to": "route"
        },
        {
          "from": "route",
          "to": "maps",
          "label": "responsibility"
        },
        {
          "from": "maps",
          "to": "out"
        },
        {
          "from": "q",
          "to": "out",
          "label": "mix"
        }
      ],
      "steps": [
        {
          "show": [
            "kv",
            "route"
          ],
          "say": "Switching linear attention keeps J linear maps, and weighs each pair by every map's error."
        },
        {
          "show": [
            "maps"
          ],
          "flow": [
            "kv>route",
            "route>maps"
          ],
          "say": "Each map takes a delta step scaled by that weight. One map is plain DeltaNet."
        },
        {
          "show": [
            "q",
            "out"
          ],
          "flow": [
            "maps>out",
            "q>out"
          ],
          "say": "A query prior mixes the maps into a piecewise linear readout."
        },
        {
          "highlight": [
            "route"
          ],
          "note": "nonlinear in the state: trained sequentially for now",
          "say": "The weights depend on the state, so training runs token by token."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Triadic: one more outer product",
      "nodes": [
        {
          "id": "k",
          "label": "Key k",
          "kind": "pill",
          "at": [
            8,
            12
          ]
        },
        {
          "id": "k2",
          "label": "Second key",
          "sub": "size E",
          "kind": "pill",
          "at": [
            8,
            50
          ]
        },
        {
          "id": "v",
          "label": "Value v",
          "kind": "pill",
          "at": [
            8,
            88
          ]
        },
        {
          "id": "op",
          "label": "outer",
          "kind": "op",
          "at": [
            38,
            50
          ]
        },
        {
          "id": "s",
          "label": "Cube state",
          "kind": "grid",
          "at": [
            70,
            50
          ],
          "sub": "d x E x d"
        }
      ],
      "edges": [
        {
          "from": "k",
          "to": "op"
        },
        {
          "from": "k2",
          "to": "op"
        },
        {
          "from": "v",
          "to": "op"
        },
        {
          "from": "op",
          "to": "s",
          "label": "write"
        }
      ],
      "steps": [
        {
          "show": [
            "k",
            "v"
          ],
          "say": "Linear attention writes the outer product of a key and a value."
        },
        {
          "show": [
            "k2",
            "op",
            "s"
          ],
          "flow": [
            "k>op",
            "k2>op",
            "v>op",
            "op>s"
          ],
          "say": "The triadic version adds a small second key and writes all three into a cube."
        },
        {
          "highlight": [
            "s"
          ],
          "note": "E times the state, two small projections",
          "say": "The key space grows E times, for two small projections."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "NHA: one softmax over two memories",
      "nodes": [
        {
          "id": "old",
          "label": "Older tokens",
          "kind": "doc",
          "at": [
            8,
            18
          ]
        },
        {
          "id": "slots",
          "label": "Summary slots",
          "sub": "gated RNN",
          "kind": "db",
          "at": [
            40,
            18
          ]
        },
        {
          "id": "recent",
          "label": "Recent tokens",
          "kind": "doc",
          "at": [
            8,
            84
          ]
        },
        {
          "id": "win",
          "label": "Exact window",
          "kind": "db",
          "at": [
            40,
            84
          ]
        },
        {
          "id": "sm",
          "label": "softmax",
          "kind": "op",
          "at": [
            74,
            50
          ]
        }
      ],
      "edges": [
        {
          "from": "old",
          "to": "slots",
          "label": "compress"
        },
        {
          "from": "recent",
          "to": "win",
          "label": "keep"
        },
        {
          "from": "slots",
          "to": "sm"
        },
        {
          "from": "win",
          "to": "sm"
        }
      ],
      "steps": [
        {
          "show": [
            "old",
            "slots"
          ],
          "flow": [
            "old>slots"
          ],
          "say": "Native Hybrid Attention compresses older tokens into summary slots."
        },
        {
          "show": [
            "recent",
            "win"
          ],
          "flow": [
            "recent>win"
          ],
          "say": "It keeps recent tokens exactly, in a sliding window."
        },
        {
          "show": [
            "sm"
          ],
          "flow": [
            "slots>sm",
            "win>sm"
          ],
          "say": "One softmax reads both, so each query weighs summary against window."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Spotlight: a memory that grows",
      "nodes": [
        {
          "id": "key",
          "label": "Key",
          "kind": "pill",
          "at": [
            8,
            18
          ]
        },
        {
          "id": "addr",
          "label": "2D address",
          "kind": "box",
          "at": [
            38,
            18
          ]
        },
        {
          "id": "cells",
          "label": "3 x 3 cells",
          "sub": "DeltaNet states",
          "kind": "grid",
          "at": [
            70,
            18
          ]
        },
        {
          "id": "pool",
          "label": "Growing lattice",
          "kind": "db",
          "at": [
            70,
            84
          ]
        },
        {
          "id": "read",
          "label": "Readout",
          "kind": "pill",
          "at": [
            30,
            84
          ]
        }
      ],
      "edges": [
        {
          "from": "key",
          "to": "addr"
        },
        {
          "from": "addr",
          "to": "cells"
        },
        {
          "from": "cells",
          "to": "pool",
          "label": "allocate",
          "dashed": true
        },
        {
          "from": "cells",
          "to": "read"
        }
      ],
      "steps": [
        {
          "show": [
            "key",
            "addr"
          ],
          "flow": [
            "key>addr"
          ],
          "say": "Spotlight maps each key to an address on a flat lattice."
        },
        {
          "show": [
            "cells"
          ],
          "flow": [
            "addr>cells"
          ],
          "say": "It touches only the three by three cells there, each a small DeltaNet state."
        },
        {
          "show": [
            "pool",
            "read"
          ],
          "flow": [
            "cells>pool",
            "cells>read"
          ],
          "say": "New addresses open new cells: memory grows, work per token does not."
        }
      ]
    },
    {
      "type": "bars",
      "title": "Recall at four times GDN's state",
      "items": [
        {
          "label": "GDN base",
          "value": "26.2"
        },
        {
          "label": "Larger heads",
          "value": "28.5"
        },
        {
          "label": "Triadic, E = 4",
          "value": "31.1",
          "hl": true
        },
        {
          "label": "Transformer",
          "value": "41.6"
        }
      ],
      "note": "400M parameters, recall average",
      "stamp": "reported",
      "say": "At equal state, the triadic key lifts recall from twenty-six point two to thirty-one point one."
    },
    {
      "type": "figure",
      "src": "/articles/linear-attention-state-roundup/fig7.png",
