      "title": "Spotlight past its training length",
      "steps": [
        {
          "say": "In the lab's own chart, Spotlight finds the needle far past its training length. No paper yet backs it."
        }
      ]
    },
    {
      "type": "takeaway",
      "text": "A fixed state is a KV cache of fixed length. Spend it on a bigger key space, or let it grow.",
      "mark": "a KV cache of fixed length",
      "say": "A fixed state is just a cache of fixed length."
    },
    {
      "type": "end",
      "recap": [
        "SwiLA: switch among J linear maps",
        "Triadic: a bigger key from two projections",
        "NHA and Spotlight: exact memory, then growth"
      ],
      "say": "Switch maps, enlarge the key, keep a window, or let memory grow."
    }
  ]
}
