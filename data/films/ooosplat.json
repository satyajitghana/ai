{
  "slug": "ooosplat",
  "kicker": "OOOSplat, a local splat app",
  "style": "riso",
  "palette": "orange-teal",
  "thumb": {
    "scene": 5
  },
  "mascot": {
    "species": "cat",
    "name": "Tripod",
    "fur": "lilac",
    "ears": "up",
    "hat": "cap",
    "glasses": "square",
    "outfit": "overalls",
    "prop": "magnifier",
    "patch": "socks",
    "accent": "#E07A2E"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "How a phone video becomes a Gaussian splat",
      "sub": "OOOSplat: a desktop app that wraps COLMAP and Brush",
      "say": "Hi, I'm Tripod! Here is how one desktop app turns a phone video into a splat scene, on your own machine."
    },
    {
      "type": "idea",
      "text": "OOOSplat drives proven engines for the hard parts and writes its own budgets, editor and exporters around them.",
      "mark": "its own budgets, editor and exporters",
      "say": "The idea: proven engines do the hard parts. The app owns the frame plan, the splat budget, the editor and the exports."
    },
    {
      "type": "steps",
      "title": "One button, five stations",
      "items": [
        {
          "text": "Pick frames from the video",
          "sub": "OOOSplat's frame plan",
          "say": "It picks frames, never fewer than thirty."
        },
        {
          "text": "Solve every camera",
          "sub": "COLMAP",
          "say": "COLMAP solves where every camera stood."
        },
        {
          "text": "Grow the Gaussians",
          "sub": "Brush, on the GPU",
          "say": "A fork of Brush trains the splats on the GPU."
        },
        {
          "text": "Crop and clean",
          "sub": "PlayCanvas preview",
          "say": "You crop in a PlayCanvas preview."
        },
        {
          "text": "Export a file",
          "sub": "PLY, SOG, HTML",
          "say": "Then export a PLY, a SOG, or one HTML file."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Who matches which frames",
      "nodes": [
        {
          "id": "frames",
          "label": "Video frames",
          "kind": "stack",
          "at": [
            10,
            20
          ]
        },
        {
          "id": "sift",
          "label": "SIFT",
          "kind": "op",
          "at": [
            40,
            20
          ]
        },
        {
          "id": "seq",
          "label": "Sequential",
          "sub": "offsets 1, 2, 4, 8",
          "kind": "box",
          "at": [
            70,
            20
          ]
        },
        {
          "id": "exh",
          "label": "Exhaustive",
          "sub": "every pair",
          "kind": "box",
          "at": [
            70,
            80
          ]
        },
        {
          "id": "map",
          "label": "Mapper",
          "sub": "cameras + points",
          "kind": "db",
          "at": [
            30,
            80
          ]
        }
      ],
      "edges": [
        {
          "from": "frames",
          "to": "sift"
        },
        {
          "from": "sift",
          "to": "seq",
          "label": "video"
        },
        {
          "from": "sift",
          "to": "exh",
          "label": "photos",
          "dashed": true
        },
        {
          "from": "seq",
          "to": "map"
        },
        {
          "from": "exh",
          "to": "map"
        }
      ],
      "steps": [
        {
          "show": [
            "frames",
            "sift"
          ],
          "flow": [
            "frames>sift"
          ],
          "say": "Every frame gets SIFT features, with one shared camera."
        },
        {
          "show": [
            "seq"
          ],
          "flow": [
            "sift>seq"
          ],
          "say": "A video is matched in order: each frame meets the frames one, two, four and eight places on."
        },
        {
          "show": [
            "exh"
          ],
          "flow": [
            "sift>exh"
          ],
          "say": "A small photo folder is matched exhaustively, every pair."
        },
        {
          "show": [
            "map"
          ],
          "flow": [
            "seq>map",
            "exh>map"
          ],
          "say": "The mapper turns matches into poses and points. On thirty test frames, all thirty registered."
        }
      ]
    },
    {
      "type": "equation",
      "title": "The Detailed splat ceiling",
      "text": "ceiling = 0.5 x sqrt(pixels / mean track)",
      "parts": [
        {
          "match": "pixels",
          "note": "every non-transparent training pixel",
          "say": "The cap grows with the square root of your pixels."
        },
        {
          "match": "mean track",
          "note": "views per point, from COLMAP",
          "say": "It shrinks as each point is seen by more views."
        },
        {
          "match": "0.5",
          "note": "one shared coefficient",
          "say": "Their logged run gives two point two million, and I reproduce it exactly."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Inside the standalone HTML",
      "nodes": [
        {
          "id": "ply",
          "label": "Edited PLY",
          "sub": "236 B per splat",
          "kind": "doc",
          "at": [
            10,
            20
          ]
        },
        {
          "id": "b64",
          "label": "base64",
          "kind": "op",
          "at": [
            40,
            20
          ]
        },
        {
          "id": "chunks",
          "label": "768 KiB chunks",
          "kind": "stack",
          "at": [
            70,
            20
          ]
        },
        {
          "id": "runtime",
          "label": "Viewer runtime",
          "sub": "PlayCanvas",
          "kind": "box",
          "at": [
            10,
            80
          ]
        },
        {
          "id": "html",
          "label": "One HTML file",
          "kind": "doc",
          "at": [
            50,
            80
          ]
        }
      ],
      "edges": [
        {
          "from": "ply",
          "to": "b64"
        },
        {
          "from": "b64",
          "to": "chunks"
        },
        {
          "from": "chunks",
          "to": "html",
          "label": "script tags"
        },
        {
          "from": "runtime",
          "to": "html",
          "label": "inlined"
        }
      ],
      "steps": [
        {
          "show": [
            "ply"
          ],
          "say": "Export writes the cropped scene as a float PLY."
        },
        {
          "show": [
            "b64",
            "chunks"
          ],
          "flow": [
            "ply>b64",
            "b64>chunks"
          ],
          "say": "It is base64 encoded into chunks of script tags."
        },
        {
          "show": [
            "runtime",
            "html"
          ],
          "flow": [
            "chunks>html",
            "runtime>html"
          ],
          "say": "The viewer is inlined too, so the file opens offline."
        }
      ]
    },
    {
      "type": "bars",
      "title": "One 2.2M-splat scene",
      "unit": "MB",
      "items": [
        {
          "label": "float PLY",
          "value": "524"
        },
        {
          "label": "standalone HTML",
          "value": "701.5",
          "hl": true
        }
      ],
      "note": "base64 adds a third, plus the viewer",
      "stamp": "reasoned",
      "say": "So the HTML is the PLY plus a third, plus the viewer. About seven hundred megabytes for their example."
    },
    {
      "type": "figure",
      "title": "The preview",
      "src": "/articles/ooosplat/fig1.jpg",
      "credit": "the project's README screenshot",
      "steps": [
        {
          "focus": [
            20,
            25,
            60,
            60
          ],
          "say": "In the preview you crop away the blurry edge of a capture."
        }
      ]
    },
    {
      "type": "takeaway",
      "text": "COLMAP and Brush do the reconstruction. OOOSplat owns the budgets and exports, so crop hard before an HTML export.",
      "mark": "crop hard"
    },
    {
      "type": "end",
      "recap": [
        "Frames, then COLMAP, then Brush",
        "A splat cap set by pixels",
        "HTML is base64 PLY plus viewer"
      ],
      "say": "To recap: frames, COLMAP, then Brush. A splat cap set by pixels. And an HTML that is your PLY in base64."
    }
  ]
