        {
          "text": "A loop closure redoes the loop",
          "sub": "13 of 13 poses",
          "say": "In my run, a loop closure redid all thirteen poses."
        },
        {
          "text": "Relinearize lazily",
          "sub": "only poses that moved",
          "say": "And poses relinearize only when they move."
