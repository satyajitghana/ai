    {
      "type": "title",
      "headline": "How a tiny voice model copies a big one",
      "sub": "Kokoro's voice, distilled to eight million parameters.",
      "punch": [
        "A 9 MB file.",
        "One CPU thread."
      ],
      "say": "Hi, I'm Chirp! Someone shrank the Kokoro voice to a tenth of its size. Here is how."
    },
    {
      "type": "idea",
      "text": "Shrink each half of Kokoro on its own, and train it on the teacher's own saved timing, pitch, features and audio.",
      "mark": "the teacher's own saved",
      "say": "Never train the small model end to end. Each half copies values the teacher already saved."
    },
    {
      "type": "diagram",
      "title": "From text to sound",
