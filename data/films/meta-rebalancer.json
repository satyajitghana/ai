  "scenes": [
    {
      "type": "title",
      "headline": "How Meta places shards, tasks and servers",
      "sub": "One expression graph, read by two different solvers",
      "punch": [
        "Objects.",
        "Bins.",
        "One graph."
      ],
      "say": "Hi, I'm Ballast! Meta puts objects into bins tens of millions of times a day. Here is how."
    },
    {
      "type": "idea",
      "text": "Every node in the graph knows two things: how its value changes when one object moves, and how to write itself as linear constraints.",
      "mark": "how its value changes when one object moves",
      "say": "Every node in the model knows two things. How its value changes when one object moves, and how to write itself as linear constraints."
    },
    {
      "type": "diagram",
      "title": "Specs compile to one graph",
      "nodes": [
        {
          "id": "spec",
          "label": "Specs",
          "sub": "capacity, spread, balance",
          "kind": "doc",
          "at": [
            16,
            18
          ]
        },
        {
          "id": "graph",
          "label": "Expression graph",
          "sub": "objects plus bins",
          "kind": "grid",
          "at": [
            62,
            18
          ]
        },
        {
          "id": "ls",
          "label": "Local search",
          "sub": "big problems",
          "kind": "box",
          "at": [
            22,
            82
          ]
        },
        {
          "id": "mip",
          "label": "Integer program",
          "sub": "small problems",
          "kind": "box",
          "at": [
            64,
            82
          ]
        }
      ],
      "edges": [
        {
          "from": "spec",
          "to": "graph",
          "label": "compile"
        },
        {
          "from": "graph",
          "to": "ls",
          "label": "delta"
        },
        {
          "from": "graph",
          "to": "mip",
          "label": "translate"
        }
      ],
      "steps": [
        {
          "show": [
            "spec"
          ],
          "say": "You describe the problem with specs. Capacity on hosts, replicas spread across racks, balanced load."
        },
        {
          "show": [
            "graph"
          ],
          "flow": [
            "spec>graph"
          ],
          "say": "They compile into one graph that grows with objects plus bins, not objects times bins."
        },
        {
          "show": [
            "ls"
          ],
          "flow": [
            "graph>ls"
          ],
          "say": "Local search asks each node for the change a move would cause."
        },
        {
          "show": [
            "mip"
          ],
          "flow": [
            "graph>mip"
          ],
          "say": "For small problems, the same nodes become an integer program for an exact solver."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Pricing one move",
      "nodes": [
        {
          "id": "move",
          "label": "Move A0",
          "sub": "host 0 to host 3",
          "kind": "pill",
          "at": [
            14,
            50
          ]
        },
        {
          "id": "l0",
          "label": "Lookup h0",
          "kind": "box",
          "at": [
            42,
            16
          ]
        },
        {
          "id": "l3",
          "label": "Lookup h3",
          "kind": "box",
          "at": [
            42,
            84
          ]
        },
        {
          "id": "cap",
          "label": "max",
          "kind": "op",
          "at": [
            68,
            16
          ]
        },
        {
          "id": "bal",
          "label": "Balance",
          "kind": "box",
          "at": [
            68,
            84
          ]
        },
        {
          "id": "tup",
          "label": "Tuple",
          "kind": "pill",
          "at": [
            82,
            50
          ]
        }
      ],
      "edges": [
        {
          "from": "move",
          "to": "l0"
        },
        {
          "from": "move",
          "to": "l3"
        },
        {
          "from": "l0",
          "to": "cap"
        },
        {
          "from": "l3",
          "to": "bal"
        },
        {
          "from": "cap",
          "to": "tup"
        },
        {
          "from": "bal",
          "to": "tup"
        }
      ],
      "steps": [
        {
          "show": [
            "move",
            "l0",
            "l3"
          ],
          "flow": [
            "move>l0",
            "move>l3"
          ],
          "say": "A move touches two leaves. Each one adds or subtracts the moved task, without summing the host again."
        },
        {
          "show": [
            "cap",
            "bal"
          ],
          "flow": [
            "l0>cap",
            "l3>bal"
          ],
          "say": "Only their parents recompute. The capacity max checks just the changed children."
        },
        {
          "show": [
            "tup"
          ],
          "flow": [
            "cap>tup",
            "bal>tup"
          ],
          "say": "Constraints are checked first, so most bad moves stop early. Goals compare in strict priority order."
        }
      ]
    },
    {
      "type": "steps",
      "title": "The local search loop",
      "say": "The loop.",
      "items": [
        {
          "text": "Rank bins hot to cold",
          "sub": "by node potential",
          "say": "Rank bins by how much they cost the objective."
        },
        {
          "text": "Try moves out of hottest",
          "sub": "single, then swap",
          "say": "Try every move out of the hottest bin, one move type at a time."
        },
        {
          "text": "Evaluate in parallel",
          "sub": "graph is read-only",
          "say": "Evaluations never change the graph, so threads run them in parallel."
        },
        {
          "text": "Apply only strict improvements",
          "say": "Apply the best move only if it strictly improves. Otherwise skip that bin."
        }
      ]
    },
    {
      "type": "figure",
      "src": "/articles/meta-rebalancer/fig4.png",
      "credit": "OSDI'24 paper, Figure 6",
      "title": "Hot bins first",
      "steps": [
        {
          "focus": [
            52,
            0,
            48,
            100
          ],
          "say": "On production sharding, hot bins first reach zero in about thirty seconds. Random order needs about a hundred."
        }
      ]
    },
    {
      "type": "bars",
      "title": "Service placement, 645k objects × 4.5k bins",
      "items": [
        {
          "label": "Local search",
          "value": "146",
