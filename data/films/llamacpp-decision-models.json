        {
          "show": [
            "req",
            "tmpl"
          ],
          "flow": [
            "req>tmpl"
          ],
          "say": "Your request goes through a template that ships inside the model file."
        },
        {
          "show": [
            "prompt"
          ],
          "flow": [
            "tmpl>prompt"
          ],
          "say": "Each question is rendered into its own prompt: state, question, and every option."
        },
        {
          "show": [
            "read"
          ],
          "flow": [
            "prompt>read"
          ],
          "say": "One forward pass, and the server picks out one raw score per option."
        },
        {
          "show": [
            "soft",
            "ans"
          ],
          "flow": [
            "read>soft",
            "soft>ans"
          ],
          "say": "Divide by a stored temperature, softmax, return probabilities. Nothing is sampled."
        }
      ]
    },
    {
      "type": "steps",
      "title": "Three ways to read a score",
      "say": "Where does the score come from?",
      "items": [
        {
          "text": "Letter logits",
          "sub": "lev and OpenJev",
          "say": "Letter models read the vocabulary at the last position, at the rows for A, B and C."
        },
        {
          "text": "Pointer dot product",
          "sub": "the causal pointer model",
          "say": "The pointer model scores each option by a dot product of two hidden states."
        },
        {
          "text": "Mask column",
          "sub": "Julia and Laya",
          "say": "Encoders score the mask token in front of each option."
        }
      ]
    },
    {
