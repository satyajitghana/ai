  "scenes": [
    {
      "type": "title",
      "headline": "How llama.cpp answers a typed question without generating",
      "sub": "One endpoint, six readouts, and the cost of each request on a CPU.",
      "punch": [
        "No tokens out.",
        "One number per option."
      ],
      "say": "Hi, I'm Kachori! llama.cpp now serves decision models: a probability for every option, and not a single generated word."
    },
    {
      "type": "idea",
      "text": "Each question becomes one prompt with every option inside it, and the server reads a score at the positions that model family was trained to use.",
      "mark": "the positions that model family was trained to use",
      "say": "Each question becomes one prompt holding all its options. One pass, and the server reads a score where that model was trained to put it."
    },
