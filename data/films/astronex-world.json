        {
          "from": "txt",
          "to": "xattn"
        }
      ],
      "steps": [
        {
          "show": [
            "cam",
            "prope"
          ],
          "flow": [
            "cam>prope"
          ],
          "say": "Camera poses feed a second attention branch whose output starts at zero."
        },
        {
          "show": [
            "act",
            "mod"
          ],
          "flow": [
            "act>mod"
