    {
      "type": "steps",
      "title": "Five stages on two cards",
      "say": "Training is five short stages on a frozen backbone, with small adapters.",
      "items": [
        {
          "text": "Add the controls",
          "sub": "full attention"
        },
        {
          "text": "Switch to the causal mask",
          "sub": "teacher forcing"
        },
        {
          "text": "Distill to fewer steps",
          "sub": "follow the teacher's path"
        },
        {
          "text": "Fine-tune on mixed data",
          "sub": "games, driving, robots"
        },
        {
          "text": "Match the teacher's distribution",
          "sub": "with a motion term"
        }
      ]
    },
    {
