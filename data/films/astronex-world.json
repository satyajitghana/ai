  "scenes": [
    {
      "type": "title",
      "headline": "How one video model learns to stream a world",
      "sub": "Astronex-World 1.0: the same weights, sampled two ways.",
      "punch": [
        "One trunk.",
        "Two masks.",
        "A short memory."
      ],
      "say": "Hi, I'm Halley! Astronex-World is a video model you steer while it plays. Here's how one set of weights does two jobs."
    },
    {
      "type": "idea",
      "text": "Sample the same weights two ways: full attention when motion must be exact, or block-causal with a KV cache to stream and steer.",
      "mark": "block-causal with a KV cache",
      "say": "Use full attention when motion must be right, or a causal mask with a cache to stream and steer."
    },
    {
      "type": "compare",
      "title": "One trunk, two attention masks",
      "left": {
        "title": "Bidirectional form",
        "items": [
          "Every frame sees every frame",
          "Fifty steps, fixed length",
          "Keeps the teacher's motion"
        ],
        "say": "Bidirectional: every frame sees every frame, fifty steps, a fixed-length clip."
      },
      "right": {
        "title": "Causal form",
        "items": [
          "Blocks of eight see only the past",
          "Eight steps over cached history",
          "Extends and steers as it plays"
        ],
        "say": "Causal: blocks of eight look only backwards, eight steps each, and the video keeps going."
      }
    },
    {
      "type": "diagram",
      "title": "What the cache holds",
      "nodes": [
        {
          "id": "sink",
          "label": "Sink frames",
          "sub": "the first four",
          "kind": "stack",
          "at": [
            14,
            14
          ]
        },
        {
          "id": "hist",
          "label": "Recent history",
          "sub": "eight frames",
          "kind": "stack",
          "at": [
            14,
            50
          ]
        },
        {
          "id": "cur",
          "label": "Current block",
          "sub": "eight noisy frames",
          "kind": "grid",
          "at": [
            14,
            86
          ]
        },
        {
          "id": "dit",
          "label": "DiT",
          "sub": "30 layers",
          "kind": "box",
          "at": [
            46,
            50
          ]
        },
        {
          "id": "cache",
          "label": "KV cache",
          "sub": "20 frames in all",
          "kind": "db",
          "at": [
            76,
            50
          ]
        }
      ],
      "edges": [
        {
          "from": "cur",
          "to": "dit"
        },
        {
          "from": "sink",
          "to": "dit"
        },
        {
          "from": "hist",
          "to": "dit"
        },
        {
          "from": "dit",
          "to": "cache",
          "label": "commit"
        },
        {
          "from": "cache",
          "to": "hist",
          "label": "kept by overlap",
          "dashed": true,
          "bend": 0.6
        }
      ],
      "steps": [
        {
          "show": [
            "cur",
            "dit"
          ],
          "flow": [
            "cur>dit"
          ],
          "say": "Each block of eight frames starts as noise, and the transformer denoises it."
        },
        {
          "show": [
            "sink",
            "hist"
          ],
          "flow": [
            "sink>dit",
            "hist>dit"
          ],
          "say": "It looks back at four sink frames from the start, and eight recent frames."
        },
        {
          "show": [
            "cache"
          ],
          "flow": [
            "dit>cache"
          ],
          "say": "Then its keys and values join a cache of twenty frames, sink included."
        },
        {
          "highlight": [
            "cache",
            "hist"
          ],
          "flow": [
            "cache>hist"
          ],
          "say": "When it's full, frames that overlap the coming view stay. The rest are gone for good."
        }
      ]
    },
    {
      "type": "diagram",
