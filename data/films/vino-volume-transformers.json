        }
      ],
      "stamp": "reported",
      "say": "Each step helps. Masked prediction adds more than the backbone swap, and distilling from DINO v2 adds the most."
    },
    {
      "type": "takeaway",
      "text": "In sparse 3D, which voxels exist is geometry. Hide it, or the student learns shapes instead of objects.",
      "mark": "which voxels exist is geometry"
    },
    {
      "type": "end",
      "recap": [
        "A ViT over 10 cm voxel cubes",
        "Clean teacher, own targets",
        "Masked tokens deleted, not hidden"
      ],
      "say": "Voxel cubes, a clean teacher with its own targets, and masks that really hide."
    }
  ]
