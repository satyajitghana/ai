  "scenes": [
    {
      "type": "title",
      "headline": "How VINO learns 3D features without labels",
      "sub": "A plain volume transformer, and four shortcuts taken away.",
      "punch": [
        "28.3 to 40.4",
        "ScanNet200, frozen"
      ],
      "say": "Hi, I'm Merlot! Frozen 3D features still confuse a chair leg with a table leg. Here is how VINO fixes that."
    },
    {
      "type": "idea",
      "text": "Use a ViT over voxel cubes, then remove every shortcut that lets the student match the teacher without understanding the scene.",
      "mark": "remove every shortcut"
    },
    {
      "type": "diagram",
      "title": "Volt: a ViT for voxels",
      "nodes": [
        {
          "id": "pts",
          "label": "Point cloud",
          "kind": "doc",
          "at": [
            7,
            18
          ]
        },
        {
          "id": "vox",
          "label": "2 cm voxels",
          "kind": "grid",
          "at": [
            38,
            18
          ]
        },
        {
          "id": "cube",
          "label": "10 cm cubes",
          "sub": "one token each",
          "kind": "stack",
          "at": [
            70,
            18
          ]
        },
        {
          "id": "tf",
          "label": "Global attention",
          "sub": "3D RoPE",
          "kind": "box",
          "tone": "hi",
          "at": [
            70,
            82
          ]
        },
        {
          "id": "out",
          "label": "Token features",
          "kind": "pill",
          "at": [
            34,
            82
          ]
        }
      ],
      "edges": [
        {
          "from": "pts",
          "to": "vox"
        },
        {
          "from": "vox",
          "to": "cube",
          "label": "patchify"
        },
        {
          "from": "cube",
          "to": "tf"
        },
        {
          "from": "tf",
          "to": "out"
        }
      ],
      "steps": [
        {
          "show": [
            "pts",
            "vox"
          ],
          "flow": [
            "pts>vox"
          ],
          "say": "Snap the points to a two centimetre grid."
        },
        {
          "show": [
            "cube"
          ],
          "flow": [
            "vox>cube"
          ],
          "say": "Cut space into cubes five voxels wide. Each cube that holds anything becomes one token."
        },
        {
          "show": [
            "tf",
            "out"
          ],
          "flow": [
            "cube>tf",
            "tf>out"
          ],
          "say": "A plain transformer attends across every token, with rotary positions in three dimensions. No pyramid, no windows."
        }
      ]
    },
    {
      "type": "stat",
      "value": "12,092 tokens",
      "label": "from 187,899 voxels in one demo room",
      "stamp": "measured",
      "say": "On a demo room, nearly two hundred thousand voxels became about twelve thousand tokens."
    },
    {
      "type": "steps",
      "title": "Four shortcuts, four fixes",
      "say": "Self distillation fails when the student can cheat. VINO closes four ways.",
      "items": [
        {
          "text": "Teacher sees clean views",
          "sub": "distort the student only",
          "say": "The teacher sees clean views. Only the student's small crops get distorted."
        },
        {
          "text": "Teacher owns its targets",
          "sub": "prototypes, Sinkhorn-Knopp",
          "say": "The teacher builds targets from its own balanced prototypes, instead of copying the student's head."
        },
        {
          "text": "Masked tokens are deleted",
          "sub": "the hole hides its shape",
          "say": "Masked tokens are removed, so the student cannot read the shape of the hole."
        },
        {
          "text": "Average voxels per cube",
          "sub": "norm stops counting",
          "say": "The tokenizer averages its voxels, so token size stops counting how full a cube is."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Predicting what was masked",
      "nodes": [
        {
          "id": "vis",
          "label": "Visible tokens",
          "kind": "stack",
          "at": [
            8,
            18
          ]
        },
        {
          "id": "enc",
          "label": "Student encoder",
          "kind": "box",
          "at": [
            38,
            18
          ]
        },
        {
          "id": "q",
          "label": "Mask queries",
          "sub": "own position only",
          "kind": "pill",
          "at": [
            13,
            82
          ]
        },
        {
          "id": "dec",
          "label": "Cross-attention",
          "sub": "no query mixing",
          "kind": "box",
          "tone": "hi",
          "at": [
            46,
            82
          ]
        },
        {
          "id": "tgt",
          "label": "Teacher targets",
          "kind": "db",
          "at": [
            72,
            42
          ]
        }
      ],
      "edges": [
        {
          "from": "vis",
          "to": "enc"
        },
        {
          "from": "enc",
          "to": "dec",
          "label": "keys, values"
        },
        {
          "from": "q",
          "to": "dec"
        },
        {
          "from": "dec",
          "to": "tgt",
          "label": "match"
        }
      ],
      "steps": [
        {
          "show": [
            "vis",
            "enc"
          ],
          "flow": [
            "vis>enc"
          ],
          "say": "The student encodes only the visible tokens."
        },
        {
          "show": [
            "q",
            "dec"
          ],
          "flow": [
            "q>dec",
            "enc>dec"
          ],
          "say": "One query sits at each masked spot and looks only at the visible scene, never at other queries."
        },
        {
          "show": [
            "tgt"
          ],
          "flow": [
            "dec>tgt"
          ],
          "say": "It predicts the teacher's prototype assignment there, from context alone."
        }
      ]
    },
    {
      "type": "figure",
      "src": "/articles/vino-volume-transformers/fig2.png",
      "credit": "paper, Figure 2",
      "steps": [
        {
          "focus": [
            20,
            0,
            20,
            100
          ],
          "say": "Sonata keeps masked regions in place, so their outline survives."
        },
        {
          "focus": [
            60,
            0,
            20,
            100
          ],
          "say": "VINO deletes them. What is left has to be inferred."
        }
      ]
    },
    {
      "type": "bars",
      "title": "ScanNet200 linear probe, mIoU",
      "items": [
        {
          "label": "Sonata, PTv3",
          "value": "28.3"
