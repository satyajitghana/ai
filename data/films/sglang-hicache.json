{
  "slug": "sglang-hicache",
  "kicker": "SGLang HiCache, read from the code",
  "style": "riso",
  "palette": "pink-blue",
  "mascot": {
    "species": "bunny",
    "name": "Gusset",
    "fur": "sky",
    "ears": "up",
    "hat": "hardhat",
    "glasses": "square",
    "outfit": "overalls",
    "prop": "clipboard",
    "patch": "belly",
    "accent": "#D6336C"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "How SGLang keeps old conversations out of prefill",
      "sub": "A KV cache that spans GPU, CPU and external storage",
      "punch": [
        "Evict it.",
        "Keep it.",
        "Load it back."
      ],
      "say": "Hi, I'm Gusset! How SGLang avoids recomputing old conversations."
    },
    {
      "type": "idea",
      "text": "A prefix evicted from the GPU is kept in CPU memory and external storage, and loaded back instead of recomputed.",
      "mark": "loaded back instead of recomputed",
      "say": "The idea: do not throw an evicted prefix away. Keep it lower down, and load it back."
    },
    {
      "type": "diagram",
      "title": "Three tiers, one radix tree",
      "nodes": [
        {
          "id": "req",
          "label": "New request",
          "sub": "same prefix",
          "kind": "doc",
          "at": [
            8,
            16
          ]
        },
        {
          "id": "tree",
          "label": "Radix tree",
          "sub": "where each prefix lives",
          "kind": "db",
          "at": [
            40,
            16
          ]
        },
        {
          "id": "gpu",
          "label": "GPU memory",
          "sub": "L1",
          "kind": "chip",
          "at": [
            74,
            16
          ]
        },
        {
          "id": "cpu",
          "label": "CPU memory",
          "sub": "L2",
          "kind": "chip",
          "at": [
            74,
            84
          ]
        },
        {
          "id": "store",
          "label": "External storage",
          "sub": "L3, shared",
          "kind": "cloud",
          "at": [
            30,
            84
          ]
        }
      ],
      "edges": [
        {
          "from": "req",
          "to": "tree",
          "label": "match"
        },
        {
          "from": "tree",
          "to": "gpu",
          "label": "hit"
        },
        {
          "from": "gpu",
          "to": "cpu",
          "label": "write through",
          "bend": 0.4
        },
        {
          "from": "cpu",
          "to": "gpu",
          "label": "load",
          "bend": 0.4
        },
        {
          "from": "cpu",
          "to": "store",
          "label": "back up",
          "bend": 0.3
        },
        {
          "from": "store",
          "to": "cpu",
          "label": "prefetch",
          "dashed": true,
          "bend": 0.3
        }
      ],
      "steps": [
        {
          "show": [
            "req",
            "tree"
          ],
          "flow": [
            "req>tree"
          ],
          "say": "The radix tree finds the longest prefix it has seen."
        },
        {
          "show": [
            "gpu"
          ],
          "flow": [
            "tree>gpu"
          ],
          "say": "If that prefix is still in GPU memory, it is reused at once."
        },
        {
          "show": [
            "cpu"
          ],
          "flow": [
            "gpu>cpu"
          ],
          "say": "With write through, each new prefix is copied down to CPU memory."
        },
        {
          "show": [
            "store"
          ],
          "flow": [
            "cpu>store"
          ],
          "say": "Then to shared storage, keyed by a hash of its tokens."
        },
        {
          "flow": [
            "store>cpu",
            "cpu>gpu"
          ],
          "say": "On a storage hit, pages are prefetched to CPU, then loaded onto the GPU."
        }
      ]
    },
    {
      "type": "grid",
      "title": "Same bytes, two layouts",
      "rows": 4,
      "cols": 8,
      "rowLabel": "layer",
      "colLabel": "page",
      "steps": [
        {
          "pattern": "rows:1",
          "label": "GPU: layer first",
          "say": "On the GPU, the cache is grouped by layer, for attention."
        },
        {
          "pattern": "cols:2",
          "label": "CPU: page first",
          "say": "In CPU memory it is grouped by page, so a page is one write."
        }
      ]
    },
    {
      "type": "steps",
      "title": "When storage is still reading",
      "say": "What if a request is ready before its prefetch finishes?",
      "items": [
        {
          "text": "Best effort",
          "sub": "use what landed",
          "say": "Best effort starts now and recomputes the rest."
        },
        {
          "text": "Wait complete",
          "sub": "wait for all",
          "say": "Wait complete waits for the whole prefix."
        },
        {
          "text": "Timeout",
          "sub": "wait, up to a limit",
          "say": "Timeout waits up to a limit that grows with the prefix."
        }
      ]
    },
    {
      "type": "compare",
      "title": "Hybrid models",
      "left": {
        "title": "Attention keys and values",
        "items": [
          "One row per token",
          "Any prefix is valid"
        ],
        "say": "Attention keeps a row per token, so any prefix is valid."
      },
      "right": {
        "title": "Mamba state",
        "items": [
          "One state, overwritten each token",
          "Valid at one checkpoint",
          "Backed up as its own object"
        ],
        "say": "A Mamba state is valid only at a checkpoint, so each checkpoint is backed up on its own."
      }
    },
    {
      "type": "equation",
      "title": "Where the 98 percent comes from",
      "text": "hit = 4112 r / (4096 (r+1) + 16 r)",
      "parts": [
        {
          "match": "4112 r",
          "note": "history the server has already seen",
          "say": "In round r of the benchmark, all but the new question was seen before."
        },
        {
          "match": "4096 (r+1) + 16 r",
          "note": "the whole prompt",
          "say": "Divide by the whole prompt. By round fifty five, that ceiling is ninety eight percent."
        }
      ]
    },
    {
      "type": "figure",
      "src": "/articles/sglang-hicache/fig3.png",
      "credit": "Unified Radix Cache blog, Figure 4",
      "title": "The benchmark behind the headline",
      "steps": [
        {
          "focus": [
            36,
            15,
            37,
            41
          ],
          "say": "GPU only falls off a cliff, then GPU plus CPU. Storage rides the ceiling."
        },
        {
          "focus": [
            74,
            15,
            26,
            41
          ],
          "say": "Effective throughput counts cached tokens as served. That is the fifteen point five times."
        }
      ]
    },
    {
      "type": "takeaway",
      "text": "Storage lets the hit rate reach the reuse that exists. The workload decides how much reuse that is.",
      "mark": "The workload decides"
    },
    {
      "type": "end",
      "recap": [
        "Radix tree tracks GPU and CPU copies",
        "Storage is shared and hash keyed",
        "98 percent is the workload's ceiling"
      ],
      "say": "One tree, three tiers, and a hit rate the workload sets. Bye!"
    }
  ]
}
