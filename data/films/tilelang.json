    {
      "type": "steps",
      "title": "Layout runs in priority order",
      "say": "Operators share buffers, and care about layout unequally.",
      "items": [
        {
          "text": "Strict first",
          "sub": "the matrix op",
          "say": "Strict first. The matrix multiply pins the layouts its instruction demands."
        },
        {
          "text": "Then common",
          "sub": "breadth first",
          "say": "Then common, spreading those layouts to everything sharing those buffers."
        },
        {
          "text": "Then free",
          "sub": "the rest",
          "say": "Then free, where the leftover loops take whatever is convenient."
        }
      ]
    },
