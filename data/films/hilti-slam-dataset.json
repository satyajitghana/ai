{
  "slug": "hilti-slam-dataset",
  "kicker": "The Hilti SLAM datasets",
  "style": "charcoal",
  "palette": "ember",
  "mascot": {
    "species": "fish",
    "name": "Hilda",
    "fur": "orange",
    "ears": "up",
    "hat": "hardhat",
    "glasses": "round",
    "outfit": "vest",
    "prop": "none",
    "patch": "belly",
    "accent": "#F2A541"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "How a steel tip grades LiDAR SLAM to the millimetre",
      "sub": "Survey marks on a construction site, and a score built on them",
      "punch": [
        "Scan the building.",
        "Touch the cross.",
        "Score the miss."
      ],
      "say": "Hi, I'm Hilda! Most mapping benchmarks check one estimator against another. This one asks a surveyor."
    },
    {
      "type": "idea",
      "text": "Survey the building first, then press the rig's steel tip onto surveyed floor crosses while recording. Each touch is a position known to a few millimetres.",
      "mark": "steel tip",
      "say": "Survey the building first. Then press the rig's steel tip onto marked floor crosses while recording. Each touch is known to a few millimetres."
    },
    {
      "type": "steps",
      "title": "Making the ground truth",
      "say": "Here is how.",
      "items": [
        {
          "text": "Laser-scan the whole building",
          "sub": "terrestrial scanner",
          "say": "A laser scanner captures the whole site, registered to within a few millimetres."
        },
        {
          "text": "Draw crosses on the floor",
          "sub": "blue adhesive markers",
          "say": "Crosses are drawn on blue markers on the floor."
        },
        {
          "text": "Scan a target on each cross",
          "sub": "a point in the map",
          "say": "A levelled target on each cross makes it a point in the map."
        },
        {
          "text": "Touch each cross while recording",
          "sub": "tip error under 1 mm",
          "say": "During the run, the operator sets the tip on each cross for a few seconds."
        }
      ]
    },
    {
      "type": "figure",
      "src": "/articles/hilti-slam-dataset/fig2.jpg",
      "credit": "Hilti-Oxford paper, Figure 8",
      "steps": [
        {
          "say": "This is one of those targets, standing on its cross."
        },
        {
          "focus": [
            55,
            55,
            45,
            40
          ],
          "say": "The leveller and the metal tip pin it to the blue marker."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Scoring one sequence",
      "nodes": [
        {
          "id": "est",
          "label": "Estimated poses",
          "sub": "inertial frame",
          "kind": "doc",
          "at": [
            10,
            14
          ]
        },
        {
          "id": "tip",
          "label": "tip",
          "kind": "op",
          "at": [
            40,
            14
          ]
        },
        {
          "id": "align",
          "label": "Rigid alignment",
          "sub": "no scale",
          "kind": "box",
          "at": [
            72,
            14
          ]
        },
        {
          "id": "marks",
          "label": "Survey marks",
          "sub": "a few per run",
          "kind": "db",
          "at": [
            72,
            52
          ]
        },
        {
          "id": "err",
          "label": "Error per mark",
          "kind": "grid",
          "at": [
            72,
            90
          ]
        },
        {
          "id": "bands",
          "label": "Score bands",
          "sub": "10, 6, 3, 1, 0",
          "kind": "stack",
          "at": [
            40,
            90
          ]
        },
        {
          "id": "score",
          "label": "Sequence score",
          "sub": "out of 100",
          "kind": "pill",
          "at": [
            10,
            90
          ]
        }
      ],
      "edges": [
        {
          "from": "est",
          "to": "tip",
          "label": "fixed offset"
        },
        {
          "from": "tip",
          "to": "align"
        },
        {
          "from": "marks",
          "to": "align",
          "dashed": true
        },
        {
          "from": "align",
          "to": "err",
          "bend": 0.5
        },
        {
          "from": "err",
          "to": "bands"
        },
        {
          "from": "bands",
          "to": "score"
        }
      ],
      "steps": [
        {
          "show": [
            "est",
            "tip"
          ],
          "flow": [
            "est>tip"
          ],
          "say": "Your poses describe the inertial sensor. A fixed offset moves each one to the steel tip."
        },
        {
          "show": [
            "align",
            "marks"
          ],
          "flow": [
            "tip>align",
            "marks>align"
          ],
          "say": "The trajectory is rigidly aligned to the survey marks, without scale."
        },
        {
          "show": [
            "err"
          ],
          "flow": [
            "align>err"
          ],
          "say": "Each mark gets one number: how far your tip was from the cross at that instant."
        },
        {
          "show": [
            "bands",
            "score"
          ],
          "flow": [
            "err>bands",
            "bands>score"
          ],
          "say": "Under a centimetre earns ten points, then six, three, one, and nothing past ten centimetres. Each sequence is scaled to a hundred."
        }
      ]
    },
    {
      "type": "compare",
      "title": "A staircase, not a curve",
      "left": {
        "title": "Root mean square error",
        "items": [
          "Smooth in every millimetre",
          "One bad section inflates it",
          "Missing poses break it"
        ],
        "say": "Root mean square error is smooth, and a missing stretch wrecks it."
      },
      "right": {
        "title": "Banded score",
        "items": [
          "9 mm scores 10, 11 mm scores 6",
          "Missing marks just score zero",
          "Orientation is never scored"
        ],
        "say": "The banded score is a staircase. Nine millimetres earns ten points, eleven earns six, and a missing mark scores zero."
      }
    },
    {
      "type": "bars",
      "title": "Dense reference vs the marks",
      "unit": "mm",
      "items": [
        {
          "label": "exp14 basement",
          "value": "6.7"
        },
        {
          "label": "exp05 upper level",
          "value": "19.9"
        },
        {
          "label": "exp04 upper level",
          "value": "29.4"
        },
        {
          "label": "exp16 attic",
          "value": "76.0",
          "hl": true
        }
      ],
      "note": "RMSE after the official alignment",
      "stamp": "measured",
      "say": "Scored the same way, the dense reference trajectories land between about seven and seventy-six millimetres from the marks."
    },
    {
      "type": "takeaway",
      "text": "Use the dense trajectory to find where odometry broke. Use the survey marks to say how well it did.",
      "mark": "survey marks",
      "say": "So use the dense trajectory to find where your odometry broke, and the survey marks to say how well it did."
    },
    {
      "type": "end",
      "recap": [
        "Survey first, then touch the crosses",
        "Score each mark in bands",
        "Dense reference is for debugging"
      ],
      "say": "Survey first, touch the crosses, score each mark in bands, and keep the dense reference for debugging."
    }
  ]
}
