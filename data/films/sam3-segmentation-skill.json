    {
      "type": "title",
      "headline": "How a skill gets SAM 3 to outline every kernel",
      "sub": "A crop plan, a raw candidate pool, review and refinement",
      "punch": [
        "Cut it up.",
        "Keep everything.",
        "Check it."
      ],
      "say": "Hi, I'm Thwart! Six agents had to outline every kernel on a corn photo. With one skill, they all could. Here is how."
    },
    {
      "type": "idea",
      "text": "SAM 3 misses small kernels in a whole photo, so the skill cuts it into overlapping tiles, keeps every mask, and makes the agent review them.",
      "mark": "overlapping tiles",
      "say": "Shrunk to the model's input, a small kernel is a speck. So the skill tiles the photo, keeps every mask, and has the agent review them."
    },
    {
      "type": "compare",
      "title": "Same prompt, different view",
      "left": {
        "title": "Whole photo",
        "items": [
          "corn kernel at threshold 0.5",
          "nothing comes back"
        ],
        "say": "On the whole photo, SAM 3 finds no kernels."
      },
      "right": {
        "title": "A 120 px region",
        "items": [
          "the same prompt and threshold",
          "80 masks"
        ],
        "say": "On a small region, eighty masks. The view was wrong, not the model."
      }
