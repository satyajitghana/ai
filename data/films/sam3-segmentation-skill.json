    {
      "type": "steps",
      "title": "Why neighbours make better clicks",
      "say": "One click is ambiguous.",
      "items": [
        {
          "text": "Click one kernel",
          "sub": "also clicks the ear",
          "say": "A click on a kernel also clicks the ear."
        },
        {
          "text": "Add three neighbour negatives",
          "sub": "centres of nearby kernels",
          "say": "So the skill adds negative clicks on neighbouring kernels."
        },
        {
          "text": "Keep only agreeing updates",
          "sub": "score, stability, area",
          "say": "An update counts only if it agrees with the original."
        }
      ]
