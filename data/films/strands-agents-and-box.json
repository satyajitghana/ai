        },
        {
          "text": "Model asks for a tool",
          "sub": "stop reason: tool use",
          "say": "If it asks for a tool, stop there."
        },
        {
          "text": "Run the tools",
          "sub": "hooks fire around each",
          "say": "Run the tools, with hooks before and after each."
        },
        {
          "text": "Call itself again",
          "sub": "until end of turn",
          "say": "Then the loop calls itself, until the model is done."
        }
