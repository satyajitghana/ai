        },
        {
          "label": "Tarka 150M",
          "value": "66.39"
        },
        {
          "label": "gte-modernbert-base",
          "value": "66.26"
        }
      ],
      "note": "The card's averages recompute exactly; it tops one of seven task types",
      "stamp": "reported",
      "say": "The card's average recomputes exactly. It leads by under a point, close to the top everywhere rather than first in most places."
    },
    {
      "type": "figure",
      "src": "/articles/ultrabert-embed/fig3.png",
      "credit": "UltraBERT paper, Figure 11",
      "title": "Passkey retrieval by document length",
      "steps": [
        {
          "say": "Hide a number in a document up to thirty-two thousand tokens long, and the backbone finds it at every length."
        }
      ]
    },
    {
      "type": "takeaway",
      "text": "Two masking ratios, each with its own head, beat any single ratio or any schedule between them.",
      "mark": "each with its own head",
      "say": "Two masking ratios, each with its own head, beat any one ratio or any schedule between them."
    },
    {
      "type": "end",
      "recap": [
