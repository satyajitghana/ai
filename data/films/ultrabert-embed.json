  "scenes": [
    {
      "type": "title",
      "headline": "How one encoder learns to classify and retrieve",
      "sub": "UltraBERT-Embed: 151M parameters, 768 numbers out, 32K tokens in.",
      "punch": [
        "Two masking ratios.",
        "Two output heads."
      ],
      "say": "Hi, I'm Monty! This is a small English embedding model, and the interesting part is its encoder."
    },
    {
      "type": "idea",
      "text": "Light masking makes a better classifier, heavy masking a better retriever. UltraBERT trains on both at once, with a separate head for each.",
      "mark": "a separate head for each",
      "say": "Hide a few tokens and you train a better classifier. Hide half and you train a better retriever. UltraBERT does both, each with its own head."
    },
    {
      "type": "diagram",
      "title": "Pre-training: two ratios, two heads",
      "nodes": [
        {
          "id": "m5",
          "label": "5% masked",
          "sub": "four of these",
          "kind": "doc",
          "at": [
            10,
            22
          ]
        },
        {
          "id": "m50",
          "label": "50% masked",
          "sub": "one of these",
          "kind": "doc",
          "at": [
            10,
            80
          ]
        },
        {
          "id": "enc",
          "label": "UltraBERT",
          "sub": "shared encoder",
          "kind": "box",
          "at": [
            42,
            51
          ]
        },
        {
          "id": "t",
          "label": "1.3B teacher",
          "kind": "box",
          "at": [
            42,
            8
          ]
        },
        {
          "id": "h5",
          "label": "5% LM head",
          "kind": "pill",
          "at": [
            76,
            22
          ]
        },
        {
          "id": "h50",
          "label": "50% LM head",
          "kind": "pill",
          "at": [
            76,
            80
          ]
        }
      ],
      "edges": [
        {
          "from": "m5",
          "to": "enc"
        },
        {
          "from": "m50",
          "to": "enc"
        },
        {
          "from": "enc",
          "to": "h5"
        },
        {
          "from": "enc",
          "to": "h50",
          "label": "plain MLM"
        },
        {
          "from": "t",
          "to": "h5",
          "label": "KL",
          "dashed": true
        }
      ],
      "steps": [
        {
          "show": [
            "m5",
            "m50"
          ],
          "say": "Each batch mixes lightly and heavily masked sequences, four to one."
        },
        {
          "show": [
            "enc"
          ],
          "flow": [
            "m5>enc",
            "m50>enc"
          ],
          "say": "Both go through the same encoder."
        },
        {
          "show": [
            "h5",
            "h50"
          ],
          "flow": [
            "enc>h5",
            "enc>h50"
          ],
          "say": "Each ratio predicts through its own head, so the two stop fighting over one projection."
        },
        {
          "show": [
            "t"
          ],
          "flow": [
            "t>h5"
          ],
          "highlight": [
            "t",
            "h5"
          ],
          "say": "A larger teacher is distilled into the light head only."
        }
      ]
    },
    {
      "type": "stack",
      "title": "One encoder layer",
      "input": "tokens",
      "output": "768-d vector",
      "layers": [
        {
          "label": "RMSNorm"
        },
        {
          "label": "Attention with RoPE"
        },
        {
          "label": "RMSNorm"
        },
        {
          "label": "SwiGLU MLP"
        }
      ],
      "repeat": {
        "from": 0,
        "to": 3,
        "label": "x 24"
      },
      "steps": [
        {
          "show": 2,
          "say": "Each layer normalises, then attends, with rotary positions."
        },
        {
          "show": 4,
          "highlight": [
            3
          ],
          "say": "Then a gated MLP, barely wider than the stream."
        },
        {
          "flow": true,
          "say": "Twenty-four layers, and the first token's final state is the embedding."
        }
      ]
    },
    {
      "type": "grid",
      "title": "Local and global attention",
      "rows": 12,
      "cols": 12,
      "rowLabel": "query",
      "colLabel": "key",
      "steps": [
        {
          "pattern": "sliding:2",
          "label": "local layer",
          "note": "128 tokens to each side",
          "say": "Two layers in three look only nearby, a hundred and twenty-eight tokens each side."
        },
        {
          "pattern": "dense",
          "label": "global layer",
          "note": "every third layer",
          "say": "Every third layer sees everything, including the last, so the pooled token reads the whole document."
        }
      ]
    },
    {
      "type": "steps",
      "title": "From encoder to embedder",
      "say": "Then the embedding model is trained on top.",
      "items": [
        {
          "text": "Contrastive on weak pairs",
          "sub": "about 500M",
          "say": "First, about five hundred million weak pairs, with in-batch negatives."
        },
        {
          "text": "Hard negatives, instructions",
          "sub": "about 5.7M",
          "say": "Then hard negatives, with an instruction on every query."
        },
        {
          "text": "Average the checkpoints",
          "say": "The release averages several checkpoints."
        }
      ]
    },
    {
      "type": "bars",
      "title": "MTEB English v2, mean over 41 tasks",
      "items": [
        {
          "label": "UltraBERT-Embed",
          "value": "67.24",
