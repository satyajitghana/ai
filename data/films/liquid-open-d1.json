{
  "slug": "liquid-open-d1",
  "kicker": "Liquid's Open d1",
  "style": "chalkboard",
  "palette": "slate",
  "mascot": {
    "species": "cat",
    "name": "Gauge",
    "fur": "ginger",
    "ears": "up",
    "hat": "bandana",
    "glasses": "monocle",
    "outfit": "vest",
    "prop": "magnifier",
    "patch": "socks",
    "accent": "#7C3AED"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "How two open decision models read an answer",
      "sub": "Liquid's d1-3B and d1-omni-600M, read from their weights and code.",
      "punch": [
        "No tokens out.",
        "Two different readouts."
      ],
      "say": "Hi, I'm Gauge! Liquid opened two decision models. Same name, same request format, and completely different ways of reading an answer."
    },
    {
      "type": "idea",
      "text": "The bigger model reads option letters from the output layer it already had. The small one grew a new head that scores every option.",
      "mark": "grew a new head",
      "say": "The bigger one reads option letters from its existing output layer. The small one grew a new head."
    },
    {
      "type": "diagram",
      "title": "The three billion model: one tree",
      "nodes": [
        {
          "id": "state",
          "label": "State",
          "sub": "text or image",
          "kind": "doc",
          "at": [
            10,
            18
          ]
        },
        {
          "id": "qs",
          "label": "Question branches",
          "sub": "options as letters",
          "kind": "stack",
          "at": [
            42,
            18
          ]
        },
        {
          "id": "lm",
          "label": "Language model",
          "sub": "causal",
          "kind": "box",
          "at": [
            76,
            18
          ]
        },
        {
          "id": "codes",
          "label": "Option letters",
          "sub": "yes, no, A, B",
          "kind": "grid",
          "at": [
            76,
            82
          ]
        },
        {
          "id": "soft",
          "label": "softmax",
          "kind": "op",
          "at": [
            44,
            82
          ]
        },
        {
          "id": "probs",
          "label": "Probabilities",
          "sub": "one per option",
          "kind": "pill",
          "at": [
            12,
            82
          ]
        }
      ],
      "edges": [
        {
          "from": "state",
          "to": "qs",
          "label": "read once"
        },
        {
          "from": "qs",
          "to": "lm"
        },
        {
          "from": "lm",
          "to": "codes",
          "label": "last position"
        },
        {
          "from": "codes",
          "to": "soft"
        },
        {
          "from": "soft",
          "to": "probs"
        }
      ],
      "steps": [
        {
          "show": [
            "state",
            "qs"
          ],
          "flow": [
            "state>qs"
          ],
          "say": "The state is the trunk of a tree, read once. Each question is a branch that never sees another question."
        },
        {
          "show": [
            "lm"
          ],
          "flow": [
            "qs>lm"
          ],
          "say": "The whole tree is one pass through the language model."
        },
        {
          "show": [
            "codes"
          ],
          "flow": [
            "lm>codes"
          ],
          "say": "At each branch's end, only the option codes are kept: yes and no, or letters."
        },
        {
          "show": [
            "soft",
            "probs"
          ],
          "flow": [
            "codes>soft",
            "soft>probs"
          ],
          "say": "A softmax gives the answer, with no temperature."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "The small omni model: a new head",
      "nodes": [
        {
          "id": "media",
          "label": "Image or audio",
          "kind": "doc",
          "at": [
            10,
            18
          ]
        },
        {
          "id": "enc",
          "label": "Media encoder",
          "sub": "runs once",
          "kind": "box",
          "at": [
            42,
            18
          ]
        },
        {
          "id": "trunk",
          "label": "Encoder trunk",
          "sub": "bidirectional",
          "kind": "box",
          "at": [
            76,
            18
          ]
        },
        {
          "id": "head",
          "label": "Decision head",
          "sub": "two layers",
          "kind": "box",
          "at": [
            76,
            82
          ]
        },
        {
          "id": "temp",
          "label": "temperature",
          "kind": "op",
          "at": [
            44,
            82
          ]
        },
        {
          "id": "probs",
          "label": "Probabilities",
          "sub": "one per option",
          "kind": "pill",
          "at": [
            12,
            82
          ]
        }
      ],
      "edges": [
        {
          "from": "media",
          "to": "enc"
        },
        {
          "from": "enc",
          "to": "trunk",
          "label": "prefix"
        },
        {
          "from": "trunk",
          "to": "head",
          "label": "every marker"
        },
        {
          "from": "head",
          "to": "temp"
        },
        {
          "from": "temp",
          "to": "probs",
          "label": "softmax"
        }
      ],
      "steps": [
        {
          "show": [
            "media",
            "enc"
          ],
          "flow": [
            "media>enc"
          ],
          "say": "A picture or voice clip is encoded once, into a prefix that cannot see the text."
        },
        {
          "show": [
            "trunk"
          ],
          "flow": [
            "enc>trunk"
          ],
          "say": "The encoder reads everything in both directions. Each option sits behind a mask marker."
        },
        {
          "show": [
            "head"
          ],
          "flow": [
            "trunk>head"
          ],
          "say": "The decision head scores the hidden state at every marker."
        },
        {
          "show": [
            "temp",
            "probs"
          ],
          "flow": [
            "head>temp",
            "temp>probs"
          ],
          "say": "For text, a fitted temperature comes before the softmax."
        }
      ]
    },
    {
      "type": "figure",
      "src": "/articles/liquid-open-d1/fig3.png",
      "credit": "Open d1 blog post, Figure 3",
      "title": "Liquid's own drawing",
      "steps": [
        {
          "focus": [
            0,
            60,
            36,
            38
          ],
          "say": "Liquid's drawing: a vision encoder or an audio encoder, never both."
        },
        {
          "focus": [
            44,
            10,
            56,
            88
          ],
          "say": "Then the encoder, with many arrows into the decision head."
        }
      ]
    },
    {
      "type": "compare",
      "title": "Same request, different cost",
      "left": {
        "title": "The three billion model",
        "items": [
          "State read once",
          "Questions never see each other",
          "No temperature"
        ],
        "say": "The bigger model reads the state once, however many questions you ask."
      },
      "right": {
        "title": "The small omni model",
        "items": [
          "State read again per question",
          "Options see each other",
          "Temperatures for text"
        ],
        "say": "The small one reads it again for every question."
      }
    },
    {
      "type": "bars",
      "title": "One question, warm, one at a time",
      "items": [
        {
          "label": "RTX 4090",
          "value": "8"
        },
        {
          "label": "AGX Thor",
          "value": "16",
          "hl": true
        },
        {
          "label": "AGX Orin 64 GB",
          "value": "26"
        },
        {
          "label": "Orin Nano",
          "value": "50"
        }
      ],
      "unit": "ms",
      "note": "Liquid's figures; the 4090 uses CUDA graphs.",
      "stamp": "reported",
      "say": "One question takes eight milliseconds on a desktop card and fifty on the smallest edge board, by Liquid's numbers."
    },
    {
      "type": "stat",
      "value": "48.57",
      "label": "Decision Index 0.2.1, self-run; the board moved to 0.3 before launch",
      "note": "First under 10B on the board it names.",
      "stamp": "reported",
      "say": "Forty eight point five seven: first under ten billion, on a board replaced the day before launch."
    },
    {
      "type": "takeaway",
      "text": "Same request format, different costs: one model shares the state across questions, the other reads it again for each.",
      "mark": "shares the state across questions",
      "say": "Same format, different costs. One shares the state across questions. The other reads it again for each."
    },
    {
      "type": "end",
      "recap": [
        "Big model: its own output layer",
        "Small model: a new decision head",
        "Check which board a ranking uses"
      ],
      "say": "Its own output layer, or a new head. And check which board a ranking comes from."
    }
  ]
}
