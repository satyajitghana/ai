          "at": 1,
          "say": "Hash their ids."
        },
        {
          "at": 2,
          "term": "Hash head: one table, its own prime size",
          "say": "Each head reduces the hash modulo its own prime, and picks one row of its own table."
        },
        {
          "at": 3,
          "say": "Glue the rows together."
        },
        {
          "at": 4,
          "say": "The hidden state gates them, and they join the residual stream."
