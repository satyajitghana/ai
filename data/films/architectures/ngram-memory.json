    {
      "type": "equation",
      "host": "left",
      "title": "The gate",
      "text": "α = σ( norm(h) · norm(W_K e) )",
      "say": "A fetched row knows nothing about context. So the model checks it.",
      "parts": [
        {
          "match": "norm(h)",
          "note": "the hidden state, which has seen the context",
          "say": "The hidden state acts as a query."
        },
        {
          "match": "norm(W_K e)",
          "note": "a key made from the fetched memory",
          "say": "The memory becomes a key."
        },
        {
          "match": "σ",
          "note": "near zero when they disagree",
          "say": "If they disagree, the gate closes, and a collision stays out."
        }
      ]
    },
