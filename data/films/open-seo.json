    {
      "type": "steps",
      "title": "What counts as a mention",
      "say": "What counts as a mention?",
      "items": [
        {
          "text": "Delete citation pills",
          "sub": "links are not names",
          "say": "Citation pills are deleted: a numbered link is a source, not a mention."
        },
        {
          "text": "Blank out bare URLs",
          "sub": "offsets stay put",
          "say": "Web addresses are blanked, keeping their length."
        },
        {
          "text": "Match name or domain",
          "sub": "one name, no aliases",
          "say": "The brand name or domain must match as a whole word. One name only, so nicknames are missed."
        },
        {
          "text": "Cited if a source matches",
          "sub": "subdomains count",
          "say": "Cited means a source on your domain or a subdomain."
        }
