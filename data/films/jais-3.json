      "type": "title",
      "headline": "How an English-first base learned Arabic",
      "sub": "Jais 3: same tokenizer, same shapes, new weights",
      "punch": [
        "No new tokens.",
        "Just training."
      ],
      "say": "Hi, I'm Gantry! IFM turned its K2 Horizon models into an Arabic family, without starting from scratch. Here is how."
    },
    {
      "type": "idea",
      "text": "Jais 3 adds no Arabic tokens. Its base vocabulary already held them, so adapting the language is just continued training.",
      "mark": "just continued training",
      "say": "The new models add no Arabic tokens. The base vocabulary already held them, so adapting is just more training."
    },
    {
      "type": "compare",
      "title": "Two ways to adapt a base",
      "left": {
        "title": "The 2024 way",
        "items": [
          "Add 32,000 Arabic tokens",
          "Initialise new embedding rows",
          "Freeze the backbone first"
        ],
        "say": "The older adapted models had to add thirty-two thousand Arabic tokens to Llama two, and train their new embeddings alone first."
      },
      "right": {
        "title": "Jais 3",
        "items": [
          "Tokenizer byte-identical to the base",
          "Every tensor shape unchanged",
          "Continue training on Arabic"
        ],
        "say": "This time the tokenizer is byte for byte the base's, every tensor keeps its shape, and only the values move."
      }
