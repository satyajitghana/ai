          "flow": [
            "img>enc"
          ],
          "say": "The photo is squeezed to a square and goes through the image encoder once."
        },
        {
          "show": [
            "pt"
          ],
          "flow": [
            "enc>pt"
          ],
          "say": "A click needs only the small point decoder, which takes the stored embedding."
