    {
      "type": "compare",
      "title": "Cache or not",
      "left": {
        "title": "Re-encode",
        "items": [
          "one encode per prompt",
          "the slow step repeats"
        ],
        "say": "Without a cache, every prompt pays for the image encoder again."
      },
      "right": {
        "title": "Keep the embedding",
        "items": [
          "one encode per image",
          "138 MB cached per image"
        ],
        "say": "With the embedding kept, the image is encoded once and every prompt is cheap."
