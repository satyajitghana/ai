  "scenes": [
    {
      "type": "title",
      "headline": "How MiniCPM-V 4.7 sees, and runs on a phone",
      "sub": "A known language model, new eyes, and experts streamed from flash.",
      "punch": [
        "Same brain.",
        "New eyes.",
        "Experts on flash."
      ],
      "say": "Hi, I'm Pip! MiniCPM-V four point seven is a vision model that runs on a phone. Here is what is new."
    },
    {
      "type": "idea",
      "text": "Keep the language model, shrink what the eyes send it, and read the experts from flash just before each layer needs them.",
      "mark": "just before each layer needs them",
      "say": "The language model is borrowed whole. What changed is how few tokens the eyes send, and how experts arrive from flash."
    },
    {
      "type": "diagram",
      "title": "From pixels to tokens",
      "nodes": [
        {
          "id": "img",
          "label": "Image",
          "sub": "448 px crops",
          "kind": "doc",
          "at": [
            12,
            18
          ]
        },
        {
          "id": "early",
          "label": "First 7 layers",
          "sub": "full resolution",
          "kind": "stack",
          "at": [
            46,
            18
          ]
        },
        {
          "id": "merge",
          "label": "Window merger",
          "sub": "4 patches to 1",
          "kind": "op",
          "tone": "hi",
          "at": [
            78,
            18
          ]
        },
        {
          "id": "late",
          "label": "20 more layers",
          "sub": "quarter the tokens",
          "kind": "stack",
          "at": [
            78,
            80
          ]
        },
        {
          "id": "proj",
          "label": "Projector",
          "sub": "4 to 1 again",
          "kind": "box",
          "at": [
            46,
            80
          ]
        },
        {
          "id": "lm",
          "label": "Language model",
          "sub": "35B-A3B MoE",
          "kind": "box",
          "at": [
            14,
            80
          ]
        }
      ],
      "edges": [
        {
          "from": "img",
          "to": "early"
        },
        {
          "from": "early",
          "to": "merge"
        },
        {
          "from": "merge",
          "to": "late"
        },
        {
          "from": "late",
          "to": "proj"
        },
        {
          "from": "proj",
          "to": "lm",
          "label": "tokens"
        }
      ],
      "steps": [
        {
          "show": [
            "img",
            "early"
          ],
          "flow": [
            "img>early"
          ],
          "say": "The image is cut into crops, and the encoder runs seven layers on every patch."
        },
        {
          "show": [
            "merge"
          ],
          "flow": [
            "early>merge"
          ],
          "highlight": [
            "merge"
          ],
          "say": "Then a small merger folds each two by two window of patches into one."
        },
        {
          "show": [
            "late"
          ],
          "flow": [
            "merge>late"
          ],
          "say": "The other twenty layers now run on a quarter of the tokens."
        },
        {
          "show": [
            "proj",
            "lm"
          ],
          "flow": [
            "late>proj",
            "proj>lm"
          ],
          "say": "A projector merges four into one again, so sixteen patches become one token. Skip the first merger for the sharper mode."
        }
      ]
    },
    {
      "type": "diagram",
      "title": "Fetching experts one layer early",
      "nodes": [
        {
          "id": "state",
          "label": "Layer L state",
          "kind": "pill",
          "at": [
            12,
            18
          ]
        },
        {
          "id": "router",
          "label": "Next router",
          "sub": "layer L+1",
          "kind": "box",
          "tone": "hi",
          "at": [
            46,
            18
          ]
        },
        {
          "id": "flash",
          "label": "Flash",
          "sub": "3-bit experts",
          "kind": "db",
          "at": [
            80,
            18
          ]
        },
        {
          "id": "cache",
          "label": "Expert cache",
          "sub": "per layer",
          "kind": "stack",
          "at": [
            80,
            80
          ]
        },
        {
          "id": "next",
          "label": "Layer L+1",
          "sub": "real router decides",
          "kind": "box",
          "at": [
            40,
            80
          ]
        }
      ],
      "edges": [
        {
          "from": "state",
          "to": "router"
        },
        {
          "from": "router",
          "to": "flash",
          "label": "guess 8"
        },
        {
          "from": "flash",
          "to": "cache",
          "label": "read early"
        },
        {
          "from": "cache",
          "to": "next"
        }
      ],
      "steps": [
        {
          "show": [
            "state",
            "router"
          ],
          "flow": [
            "state>router"
          ],
          "say": "While a layer works, its state is shown to the next layer's own router."
        },
        {
          "show": [
            "flash"
          ],
          "flow": [
            "router>flash"
          ],
          "say": "That router guesses its eight experts, and reads from flash start early."
        },
        {
          "show": [
            "cache"
          ],
          "flow": [
            "flash>cache"
          ],
          "say": "They land in a per-layer cache that also keeps recently used experts."
        },
        {
          "show": [
            "next"
          ],
          "flow": [
            "cache>next"
          ],
          "highlight": [
            "next"
          ],
          "say": "Then the real router decides. Cached experts compute first while missing ones load. A wrong guess wastes a read, never an answer."
        }
      ]
    },
    {
      "type": "compare",
      "title": "Waiting versus scheduling",
      "left": {
        "title": "Wait for all eight",
        "items": [
          "Read every missing expert",
          "Then compute the layer",
          "8.0 ms per layer"
        ],
        "say": "Without this, a layer reads its experts one by one, then computes. About eight milliseconds a layer."
      },
      "right": {
        "title": "Compute what is here",
        "items": [
          "Most experts already cached",
          "Reads overlap the math",
          "No retraining needed"
        ],
        "say": "With a warm cache and an early guess, the last read hides behind the math."
      }
    },
    {
      "type": "bars",
      "title": "Decode speed on an iPad Pro M4",
      "unit": "t/s",
      "items": [
        {
          "label": "From flash, naive",
          "value": "2.97"
        },
        {
          "label": "Scheduling",
          "value": "9.81"
        },
        {
          "label": "Plus quantization",
          "value": "14.92"
        },
        {
          "label": "Plus drafting",
          "value": "17.39",
          "hl": true
        }
      ],
      "note": "OpenBMB's measurements; only the scheduling step is lossless",
      "stamp": "reported",
      "say": "OpenBMB's ladder: three tokens a second from flash, nearly ten with scheduling, past seventeen with quantization and a drafter. Only scheduling leaves the output untouched."
    },
    {
      "type": "takeaway",
      "text": "Reuse the next layer's router a layer early and keep a warm per-layer cache: a big MoE stops waiting on flash.",
      "mark": "warm per-layer cache",
      "say": "Ask the next router early, keep a warm cache, and compute what you have while fetching the rest."
    },
    {
      "type": "end",
      "recap": [
        "Same language model, new vision stack",
        "Sixteen patches become one token",
        "Experts fetched from flash one layer early"
      ],
      "say": "Borrowed brain, frugal eyes, experts just in time."
    }
  ]
