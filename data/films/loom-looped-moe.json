{
  "slug": "loom-looped-moe",
  "kicker": "LOOM and Looped-DiT, read closely",
  "style": "neon",
  "palette": "ocean",
  "mascot": {
    "species": "capybara",
    "name": "Gravel",
    "fur": "caramel",
    "ears": "up",
    "hat": "bandana",
    "glasses": "square",
    "outfit": "vest",
    "prop": "pointer",
    "patch": "none",
    "accent": "#2EE6D6"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "How to loop a model more than twice",
      "sub": "LOOM for MoE language models, Looped-DiT for images",
      "punch": [
        "Same weights.",
        "More depth."
      ],
      "say": "Hi, I'm Gravel! Looped models reuse the same layers. Most recipes stop at two loops. Two new papers go further."
    },
    {
      "type": "idea",
      "text": "Each loop should add new computation while the recurrent state stays stable.",
      "mark": "add new computation",
      "say": "Each loop should add new computation while the state stays stable."
    },
    {
      "type": "diagram",
      "title": "One LOOM loop",
      "nodes": [
        {
          "id": "x",
          "label": "Token embedding",
          "kind": "doc",
          "at": [
            10,
            15
          ]
        },
        {
          "id": "blk",
          "label": "Shared MoE block",
          "sub": "M layers",
          "kind": "stack",
          "at": [
            46,
            15
          ]
        },
        {
          "id": "rt",
          "label": "Loop router",
          "sub": "one per loop",
          "at": [
            80,
            15
          ]
        },
        {
          "id": "st",
          "label": "Loop state",
          "kind": "pill",
          "at": [
            46,
            85
          ]
        },
        {
          "id": "mem",
          "label": "Looping Residual",
          "sub": "EMA memory",
          "kind": "db",
          "at": [
            80,
            85
          ]
        }
      ],
      "edges": [
        {
          "from": "x",
          "to": "blk"
        },
        {
          "from": "rt",
          "to": "blk",
          "label": "picks experts"
        },
        {
          "from": "blk",
          "to": "st",
          "label": "scaled updates"
        },
        {
          "from": "blk",
          "to": "mem"
        },
        {
          "from": "mem",
          "to": "st",
          "label": "carried forward"
        },
        {
          "from": "x",
          "to": "st",
          "label": "re-injected",
          "dashed": true
        }
      ],
      "steps": [
        {
          "show": [
            "x",
            "blk"
          ],
          "flow": [
            "x>blk"
          ],
          "say": "A token's embedding enters one shared block of mixture of experts layers."
        },
        {
          "show": [
            "rt"
          ],
          "flow": [
            "rt>blk"
          ],
          "say": "Each loop gets its own router, so different loops can pick different experts."
        },
        {
          "show": [
            "st"
          ],
          "flow": [
            "blk>st"
          ],
          "say": "Every update is scaled down by loop count and depth, so the state's variance stays bounded."
        },
        {
          "show": [
            "mem"
          ],
          "flow": [
            "blk>mem",
            "mem>st"
          ],
          "say": "A small moving average of attention outputs carries earlier loops forward."
        },
        {
          "flow": [
            "x>st"
          ],
          "highlight": [
            "x",
            "st"
          ],
          "say": "And the input embedding is mixed back in each loop, with a shrinking weight."
        }
      ]
    },
    {
      "type": "steps",
      "title": "Segmented backprop",
      "say": "Loom trains deep loops in segments.",
      "items": [
        {
          "text": "Run three loops",
          "sub": "one segment",
          "say": "Run up to three loops."
        },
        {
          "text": "Loss, backward, optimizer step",
          "say": "Take a loss, a backward pass, and an optimizer step."
        },
        {
          "text": "Detach the state",
          "sub": "keep it, drop gradients",
          "say": "Pass the state on, without gradients."
        },
        {
          "text": "Next segment",
          "say": "At nine loops, that is three optimizer steps per batch."
        }
      ]
    },
    {
      "type": "bars",
      "title": "700M MoE at near-matched FLOPs",
      "unit": "PPL",
      "items": [
        {
          "label": "No loop",
          "value": "18.36"
        },
        {
          "label": "2 loops",
          "value": "17.37"
        },
        {
          "label": "4 loops",
          "value": "16.58"
        },
        {
          "label": "5 loops",
          "value": "16.54",
          "hl": true
        }
      ],
      "note": "top-k shrinks from 26 to 4 to pay for loops",
      "stamp": "reported",
      "say": "At near-matched compute, the seven hundred million parameter model is best at five loops. Lower is better."
    },
    {
      "type": "stat",
      "value": "9.62 → 7.77",
      "label": "1.7B perplexity at 9 loops, without FLOP matching",
      "note": "about 9x the compute and KV cache",
      "stamp": "reported",
      "say": "Without matching compute, the larger model trains stably to nine loops, at about nine times the cost."
    },
    {
      "type": "stack",
      "title": "Looped-DiT inside one denoising step",
      "input": "noisy image",
      "output": "clean prediction",
      "layers": [
        {
          "label": "Pre-loop, 6 blocks"
        },
        {
          "label": "Looped, 5 blocks"
        },
        {
          "label": "Post-loop, 6 blocks"
        }
      ],
      "repeat": {
        "from": 1,
        "to": 1,
        "label": "x 4"
      },
      "side": {
        "label": "Deep Supervision",
        "to": 2
      },
      "steps": [
        {
          "show": 3,
          "flow": true,
          "say": "The diffusion paper runs the middle five blocks four times inside every denoising step."
        },
        {
          "highlight": [
            1
          ],
          "note": "attention damped inside the loop",
          "say": "Inside the loop, attention is damped, so updates stop erasing where each patch sits."
        },
        {
          "side": true,
          "say": "In training, every loop's output is supervised against the clean image."
        }
      ]
    },
    {
      "type": "compare",
      "title": "Spending the same inference budget",
      "left": {
        "title": "More denoising steps",
        "items": [
          "One loop, more steps",
          "Re-solves the same path finer"
        ],
        "say": "Diffusion can spend compute on more denoising steps."
      },
      "right": {
        "title": "More loops per step",
        "items": [
          "Four loops, fewer steps",
          "More depth before each step"
        ],
        "say": "At the same budget, more loops at fewer steps scored higher."
      }
    },
    {
      "type": "figure",
      "src": "/articles/loom-looped-moe/fig5.png",
      "credit": "Looped-DiT paper, Figure 1",
      "steps": [
        {
          "focus": [
            0,
            53,
            60,
            46
          ],
          "say": "Here, a sign is misspelled at loops one to three, and right at loop four."
