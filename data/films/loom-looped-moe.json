      ]
    },
    {
      "type": "takeaway",
      "text": "Loop count is a property of the training recipe, not of the architecture.",
      "mark": "the training recipe",
      "say": "Two loops was the limit of naive recipes, not of looping."
    },
    {
      "type": "end",
      "recap": [
        "Scale updates, re-inject the input",
        "A router per loop, a memory across loops",
        "Loops beat extra steps in diffusion"
      ],
      "say": "Keep the state stable. Make every loop different."
    }
  ]
