    {
      "type": "compare",
      "title": "Two ways to read the scores",
      "left": {
        "title": "Letter readout",
        "items": [
          "Options go in the prompt as A, B, C",
          "Read the letters from one logit vector",
          "Slot A is worth +1.71 logits"
        ],
        "say": "One readout lists the options as letters and reads them from one position. That brings a slot bias: A is worth one point seven one logits."
      },
      "right": {
        "title": "Per-candidate likelihood",
        "items": [
          "Each candidate gets its own branch",
          "Score is its tokens' summed log-probability",
          "No order bias; a length bias instead"
        ],
        "say": "The other gives each candidate its own branch, and sums its tokens' log-probabilities. No order bias, a length bias instead."
      }
