{
  "slug": "squeeze3d",
  "kicker": "Squeeze3D, latent-space bridging",
  "style": "crayon",
  "palette": "berry",
  "mascot": {
    "species": "dog",
    "name": "Zest",
    "fur": "peach",
    "ears": "lop",
    "hat": "yuzu",
    "glasses": "round",
    "outfit": "overalls",
    "prop": "magnifier",
    "patch": "socks",
    "accent": "#D9822B"
  },
  "scenes": [
    {
      "type": "title",
      "headline": "How a 3D generator becomes a decompressor",
      "sub": "Two small adapters between frozen models, trained on latents alone.",
      "punch": [
        "Frozen encoder.",
        "Frozen generator.",
        "A tiny code."
      ],
      "say": "Hi, I'm Zest! Squeeze3D shrinks a textured mesh into a code of a few kilobytes. Here's how."
    },
    {
      "type": "idea",
      "text": "Map a frozen encoder's latent into a short code, then map that code into a frozen generator's latent, and let the generator rebuild the object.",
      "mark": "let the generator rebuild the object"
    },
    {
      "type": "diagram",
      "title": "One mesh through the bridge",
      "nodes": [
        {
          "id": "obj",
          "label": "Your mesh",
          "sub": "6.43 MB",
          "kind": "doc",
          "at": [
            16,
            14
          ],
          "tone": "light"
        },
        {
          "id": "enc",
          "label": "Encoder",
          "sub": "frozen",
          "kind": "box",
          "at": [
            46,
            14
          ]
        },
        {
          "id": "fwd",
          "label": "Forward adapter",
          "kind": "box",
          "tone": "a",
          "at": [
            76,
            14
          ]
        },
        {
          "id": "code",
          "label": "Code",
          "sub": "770 numbers",
          "kind": "pill",
          "tone": "hi",
          "at": [
            76,
            52
          ]
        },
        {
          "id": "rev",
          "label": "Reverse adapter",
          "kind": "box",
          "tone": "a",
          "at": [
            76,
            90
          ]
        },
        {
          "id": "gen",
          "label": "Generator",
          "sub": "frozen",
          "kind": "box",
          "at": [
            46,
            90
          ]
        },
        {
          "id": "out",
          "label": "New mesh",
          "kind": "doc",
          "at": [
            16,
            90
          ],
          "tone": "light"
        }
      ],
      "edges": [
        {
          "from": "obj",
          "to": "enc"
        },
        {
          "from": "enc",
          "to": "fwd"
        },
        {
          "from": "fwd",
          "to": "code",
          "label": "squeeze"
        },
        {
          "from": "code",
          "to": "rev"
        },
        {
          "from": "rev",
          "to": "gen",
          "label": "triplane"
        },
        {
          "from": "gen",
          "to": "out"
        }
      ],
      "steps": [
        {
          "show": [
            "obj",
            "enc"
          ],
          "flow": [
            "obj>enc"
          ],
          "say": "Start with any mesh. A frozen encoder reads it into a big latent."
        },
        {
          "show": [
            "fwd",
            "code"
          ],
          "flow": [
            "enc>fwd",
            "fwd>code"
          ],
          "say": "The forward adapter squeezes that into a short code, seven hundred and seventy numbers. That code is the file you keep."
        },
        {
          "show": [
            "rev",
            "gen"
          ],
          "flow": [
            "code>rev",
            "rev>gen"
          ],
          "say": "To decompress, the reverse adapter expands the code into the generator's own latent."
        },
        {
          "show": [
            "out"
          ],
          "flow": [
            "gen>out"
          ],
          "say": "The frozen generator builds a fresh textured mesh. Only the adapters ever trained."
        }
      ]
    },
    {
      "type": "steps",
      "title": "Training data the generator makes itself",
      "say": "Training pairs come from the generator itself.",
      "items": [
        {
          "text": "Generate an object",
          "sub": "from a prompt or image",
          "say": "Ask the generator for an object, and keep its latent."
        },
        {
          "text": "Encode that object",
          "sub": "frozen encoder",
          "say": "Encode that object. Now you have an exact pair."
        },
        {
          "text": "Match latents only",
          "sub": "no decoder in the loop",
          "say": "Train the adapters on latents only. Nothing is rendered."
        }
      ]
    },
    {
      "type": "equation",
      "title": "The loss",
      "text": "loss = MSE(latents) + w * |Zn Zn^T - I|^2",
      "parts": [
        {
          "match": "MSE(latents)",
          "note": "predicted versus true generator latent",
          "say": "One term pulls the predicted latent onto the true one."
        },
        {
          "match": "|Zn Zn^T - I|^2",
          "note": "normalised codes in a batch pushed apart",
          "say": "The other scales each code in a batch to unit length and pushes every pair toward orthogonal."
        }
      ]
    },
    {
      "type": "grid",
      "title": "The batch Gram, before and after",
      "rows": 8,
      "cols": 8,
      "rowLabel": "code",
      "colLabel": "code",
      "steps": [
        {
          "pattern": "dense",
          "label": "latent MSE only",
          "say": "With the latent loss alone, the codes crowd into a few directions."
        },
        {
          "pattern": "diagonal",
          "label": "with the Gram loss",
          "say": "With the Gram term, the batch turns orthogonal, which decorrelates the code's dimensions, as in Barlow Twins."
        }
      ]
    },
    {
      "type": "figure",
      "src": "/articles/squeeze3d/fig4.jpg",
      "credit": "Squeeze3D project page, mesh comparison",
      "steps": [
        {
          "focus": [
            58,
            0,
            42,
            100
          ],
          "say": "On meshes it works, from a three kilobyte code."
        }
      ]
    },
    {
      "type": "bars",
      "title": "Point-cloud ratio, by what you divide",
      "unit": "x",
      "items": [
        {
          "label": "Against ASCII files",
          "value": "58.5"
        },
        {
          "label": "Against binary floats",
          "value": "12",
          "hl": true
        }
      ],
      "note": "same 2,048 points, same code",
      "say": "But a ratio is just file over code. Against text files, point clouds get fifty-eight and a half. Against binary floats, about twelve."
    },
    {
      "type": "takeaway",
      "text": "The bridge is the idea to keep: latent losses alone can connect two frozen models, if the code is kept from collapsing.",
      "mark": "latent losses alone"
    },
    {
      "type": "end",
      "recap": [
        "Frozen encoder, frozen generator",
        "Two adapters trained on latents",
        "Gram loss keeps the code spread"
      ],
      "say": "Frozen models at both ends, two adapters between, and a Gram loss that keeps the code spread."
    }
  ]
}
