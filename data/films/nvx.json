    {
      "type": "title",
      "headline": "How NVX builds a sandbox machine from nothing",
      "sub": "One small virtual machine per untrusted agent workload.",
      "punch": [
        "No firmware.",
        "No PCI.",
        "Fixed slots."
      ],
      "say": "Hi, I'm Runnel! Here is how Microsoft's NVX gives each agent workload its own tiny virtual machine."
    },
    {
      "type": "idea",
      "text": "Do not trim a standard PC. Construct only an allowlisted machine, with the same clock and devices on every hypervisor.",
      "mark": "Construct only an allowlisted machine",
      "say": "The idea. Do not trim a whole PC. Build only the machine you allow, the same on every hypervisor."
    },
    {
      "type": "compare",
      "title": "Trim a PC, or build one",
      "left": {
        "title": "The usual VMM",
        "items": [
          "Emulate a whole PC",
