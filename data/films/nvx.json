    {
      "type": "steps",
      "title": "Snapshot once, restore many",
      "say": "Fast starts come from snapshots.",
      "items": [
        {
          "text": "Guest asks for a snapshot",
          "sub": "source VM ends",
          "say": "The guest asks for a snapshot, and its machine stops for good."
        },
        {
          "text": "Restore maps memory privately",
          "sub": "copy on write",
          "say": "Each restore maps the saved memory privately, so clones keep their own writes."
        },
        {
          "text": "Fresh entropy from the host",
          "sub": "64 bytes",
          "say": "The host sends sixty four fresh random bytes, so clones never share keys."
        },
        {
          "text": "Guest fixes its clock",
          "sub": "then runs",
          "say": "The guest fixes its clock before any workload runs."
        }
      ]
