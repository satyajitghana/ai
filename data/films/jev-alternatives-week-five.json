      "type": "title",
      "headline": "How a decision model reads its options as a set",
      "sub": "Jeva for text, VideoJev for video.",
      "punch": [
        "Any order.",
        "Same answer."
      ],
      "say": "Hi, I'm Rummy! Two papers this week build decision models around the decision itself."
    },
    {
      "type": "idea",
      "text": "Encode the request and every option separately, then let one small block read the options as a set. Order cannot change the answer.",
      "mark": "read the options as a set",
      "say": "Jeva encodes the request and every option on its own, then reads the options as a set. Shuffling cannot change the answer."
    },
    {
      "type": "compare",
      "title": "Where order sneaks in",
      "left": {
        "title": "One ordered prompt",
        "items": [
          "Options written into one list",
          "Each option sees the ones before it",
          "A shuffle can flip the pick"
        ],
        "say": "Most decision models write options into one prompt, so each sees the ones before it."
      },
      "right": {
        "title": "Jeva: each option alone",
        "items": [
          "No index in the option text",
          "Same vector in every request",
          "The block sums over a set"
        ],
        "say": "Jeva encodes each option alone. A sum over a set ignores order."
      }
