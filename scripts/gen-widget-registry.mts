// gen-widget-registry: write components/mdx/widget-registry.generated.ts, one
// import() per client widget that some MDX file imports. See
// lib/mdx/remark-lazy-widgets.mjs for why. Runs before dev and build;
// `--check` (part of `pnpm validate`) fails when the committed file is stale.
//
//   pnpm gen:widgets          # rewrite the registry
//   pnpm gen:widgets --check  # exit 1 if it would change

import { existsSync, readFileSync, writeFileSync } from "node:fs"
import { join } from "node:path"

import { collectWidgets } from "../lib/mdx/widgets.mjs"

const root = process.cwd()
const out = join(root, "components", "mdx", "widget-registry.generated.ts")
const widgets: string[] = collectWidgets(root)

const body = [
  "// Generated by scripts/gen-widget-registry.mts. Do not edit; run `pnpm gen:widgets`.",
  "// One import() per article widget so each is its own chunk (components/mdx/lazy-widget.tsx).",
  "",
  "export const WIDGETS: Record<string, () => Promise<Record<string, unknown>>> = {",
  ...widgets.map((rel) => `  ${JSON.stringify(rel)}: () => import(${JSON.stringify(`@/components/articles/${rel}`)}),`),
  "}",
  "",
].join("\n")

const current = existsSync(out) ? readFileSync(out, "utf8") : ""
if (process.argv.includes("--check")) {
  if (current !== body) {
    console.error(`✗ widget registry is stale (${widgets.length} widgets): run pnpm gen:widgets`)
    process.exit(1)
  }
  console.log(`✓ widget registry current — ${widgets.length} lazily loaded article widgets`)
} else {
  if (current !== body) writeFileSync(out, body)
  console.log(`widget registry: ${widgets.length} article widgets`)
}
