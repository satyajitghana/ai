{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.thesatyajit.com/schemas/math-reel.json",
  "title": "Math reel spec",
  "description": "One 15-20 s reel per openai/math result family, at data/math-reels/<id>.json. Contract and authoring guide: brand-crew/skills/math-reels/SKILL.md. Rich text fields accept $TeX$, ==accent== and **bold**; anything that is not Latin text goes inside $...$.",
  "type": "object",
  "required": ["id", "discipline", "kind", "short", "title", "object", "achievement", "verify", "sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[0-9]{3}$", "description": "Family number, three digits; also the file name." },
    "discipline": {
      "enum": ["Number theory", "Algebraic and complex geometry", "Real and complex analysis", "Convex and metric geometry", "Theoretical computer science", "Dynamical systems and ergodic theory", "Combinatorics", "Algebra", "Probability and statistical mechanics", "Mathematical logic", "Group theory", "Mathematical physics", "Operator algebras", "Topology", "Functional analysis", "Differential geometry", "Partial differential equations"],
      "description": "Exactly the catalogue's discipline; sets the accent colour."
    },
    "kind": { "enum": ["proof", "disproof", "counterexample", "improved-bound", "partial", "conditional"], "description": "Shown as 'Claimed proof', 'Claimed improved bound', ..." },
    "short": { "type": "string", "maxLength": 80, "description": "Rich text, at most 44 visible characters: the name in the top bar of every scene after the title." },
    "title": {
      "type": "object", "required": ["title"], "additionalProperties": false,
      "properties": {
        "dur": { "type": "number", "minimum": 2, "maximum": 3, "default": 2.6 },
        "title": { "type": "string", "description": "Rich text, at most 64 visible characters, two lines at 60 px." },
        "subtitle": { "type": "string", "description": "Rich text, at most 110 visible characters. Starts with 'Claim:' when it states the result." }
      }
    },
    "object": {
      "type": "object", "additionalProperties": true,
      "description": "The mathematical object, 6-9 s. Either one primitive's parameters inline (primitive: ...) or panels[] of 1-3 primitives.",
      "properties": {
        "dur": { "type": "number", "minimum": 6, "maximum": 9, "default": 8 },
        "heading": { "type": "string", "description": "Optional rich text over the stage, at most 72 visible characters." },
        "layout": { "enum": ["single", "split", "sequence"], "description": "Default: single for one panel, sequence for more." },
        "primitive": { "$ref": "#/$defs/primitiveName" },
        "panels": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/panel" } },
        "beats": {
          "type": "array", "maxItems": 3,
          "items": { "type": "object", "required": ["at", "text"], "additionalProperties": false, "properties": { "at": { "type": "number", "minimum": 0 }, "text": { "type": "string", "description": "Rich text caption, at most 96 visible characters." } } }
        }
      }
    },
    "achievement": {
      "type": "object", "required": ["form"],
      "properties": {
        "dur": { "type": "number", "minimum": 3, "maximum": 5, "default": 4.4 },
        "form": { "enum": ["bound", "status"] },
        "heading": { "type": "string" },
        "before": { "$ref": "#/$defs/side" },
        "after": { "$ref": "#/$defs/side" },
        "label": { "type": "string", "description": "status: what the statement was (e.g. 'Conjecture of Erdős (1975)'), at most 72 characters." },
        "statement": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "description": "TeX (no $), one line each." } },
        "context": { "type": "string", "description": "status: what was known before, rich text, at most 110 characters." },
        "stamp": { "enum": ["proved", "disproved", "counterexample", "improved", "partial", "conditional"], "description": "Always drawn with 'CLAIMED' above it. Required feel for status; optional for bound." },
        "note": { "type": "string", "description": "One line under it all: the most important qualification. Rich text, at most 80 characters." }
      },
      "allOf": [
        { "if": { "properties": { "form": { "const": "bound" } } }, "then": { "required": ["before", "after"] } },
        { "if": { "properties": { "form": { "const": "status" } } }, "then": { "required": ["statement"] } }
      ]
    },
    "verify": {
      "type": "object", "required": ["lean"], "additionalProperties": false,
      "properties": {
        "dur": { "type": "number", "minimum": 2, "maximum": 3, "default": 2.6 },
        "lean": { "enum": ["main", "part", "none"], "description": "Must match the catalogue's l (0 main, 1 part, 2 none)." },
        "detail": { "type": "string", "description": "What exactly is (or is not) formalized, rich text, at most 100 characters." },
        "review": { "type": "string", "default": "Claim, not yet peer-reviewed", "description": "The standing caveat; must still say 'claim'." },
        "ourCheck": { "type": "string", "description": "What we did and did not check, at most 80 characters." }
      }
    },
    "end": { "type": "object", "additionalProperties": false, "properties": { "dur": { "type": "number", "minimum": 1.2, "maximum": 2, "default": 1.6 }, "path": { "type": "string", "default": "/articles/openai-math" } } },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["ref", "quote"], "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "pattern": "^(article|catalogue|review)", "description": "article ... | catalogue ... | review <id>, <field>" },
          "quote": { "type": "string", "description": "Verbatim; check.mjs verifies article and catalogue quotes always, review quotes with --reviews." }
        }
      }
    }
  },
  "$defs": {
    "primitiveName": { "enum": ["numberline", "graph", "grid", "plot", "shape", "venn", "sequence", "equation", "tree"] },
    "side": {
      "type": "object", "required": ["label", "tex"], "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "Caps label, e.g. 'Best known, Aug 2026' / 'Claimed, 2 Oct 2026'." },
        "tex": { "type": "string", "description": "TeX without $ delimiters, set at 52/60 px; keep it under ~22 rendered characters." },
        "note": { "type": "string", "description": "Who/where, rich text, at most 80 characters." }
      }
    },
    "panel": {
      "type": "object", "required": ["primitive"],
      "properties": {
        "primitive": { "$ref": "#/$defs/primitiveName" },
        "from": { "type": "number", "description": "sequence layout: panel start, seconds into the object scene" },
        "until": { "type": "number", "description": "sequence layout: panel end" }
      },
      "allOf": [
        { "if": { "properties": { "primitive": { "const": "numberline" } } }, "then": { "$ref": "#/$defs/numberline" } },
        { "if": { "properties": { "primitive": { "const": "graph" } } }, "then": { "$ref": "#/$defs/graph" } },
        { "if": { "properties": { "primitive": { "const": "grid" } } }, "then": { "$ref": "#/$defs/grid" } },
        { "if": { "properties": { "primitive": { "const": "plot" } } }, "then": { "$ref": "#/$defs/plot" } },
        { "if": { "properties": { "primitive": { "const": "shape" } } }, "then": { "$ref": "#/$defs/shape" } },
        { "if": { "properties": { "primitive": { "const": "venn" } } }, "then": { "$ref": "#/$defs/venn" } },
        { "if": { "properties": { "primitive": { "const": "sequence" } } }, "then": { "$ref": "#/$defs/sequence" } },
        { "if": { "properties": { "primitive": { "const": "equation" } } }, "then": { "$ref": "#/$defs/equation" } },
        { "if": { "properties": { "primitive": { "const": "tree" } } }, "then": { "$ref": "#/$defs/tree" } }
      ]
    },
    "tone": { "type": "string", "description": "accent|claim|new (the discipline colour), ink, soft, old|mute, faint, ok, warn, bad, hot, cool, or #rrggbb" },
    "mark": {
      "type": "object", "required": ["v"],
      "properties": {
        "v": { "type": "number" }, "label": { "type": "string" }, "note": { "type": "string" }, "tone": { "$ref": "#/$defs/tone" },
        "at": { "type": "number" }, "side": { "enum": ["above", "below"] }, "style": { "enum": ["dot", "ring"] },
        "derived": { "type": "string", "description": "The formula a non-integer position was computed from, when the decimal itself is not quoted." }
      }
    },
    "numberline": {
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" }, "max": { "type": "number" }, "y": { "type": "number", "description": "axis height as a fraction of the stage, default 0.62" },
        "ticks": { "type": "array", "items": { "oneOf": [{ "type": "number" }, { "type": "object", "required": ["v", "label"] }] } },
        "axisLabel": { "type": "string" },
        "markers": { "type": "array", "items": { "$ref": "#/$defs/mark" } },
        "ranges": { "type": "array", "items": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "number" }, "to": { "type": "number" }, "label": { "type": "string" }, "note": { "type": "string" }, "tone": { "$ref": "#/$defs/tone" }, "at": { "type": "number" }, "side": { "enum": ["above", "below"] } } } },
        "slide": { "type": "object", "required": ["from", "to", "at"], "properties": { "from": { "type": "number" }, "to": { "type": "number" }, "at": { "type": "number" }, "dur": { "type": "number", "default": 1.4 }, "label": { "type": "string" }, "note": { "type": "string" }, "tone": { "$ref": "#/$defs/tone" } } },
        "zoom": { "type": "object", "required": ["min", "max", "at"], "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "at": { "type": "number" }, "dur": { "type": "number", "default": 2 }, "counter": { "type": "boolean" }, "ticks": { "type": "array" } } },
        "arrow": { "type": "boolean" }
      }
    },
    "graph": {
      "properties": {
        "preset": { "enum": ["twopage", "butterfly", "complete"] },
        "n": { "type": "integer" },
        "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "x", "y"], "properties": { "id": { "type": "string" }, "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 }, "label": { "type": ["string", "number"] }, "tone": { "$ref": "#/$defs/tone" }, "fill": { "$ref": "#/$defs/tone" } } } },
        "edges": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 3 } },
        "crossings": { "type": "boolean" }, "counter": { "type": "object", "properties": { "label": { "type": "string" }, "done": { "type": "string" } } },
        "labels": { "type": "boolean" }, "colours": { "type": "array", "items": { "$ref": "#/$defs/tone" } },
        "inLabel": { "type": "string" }, "outLabel": { "type": "string" }, "highlight": { "type": "string" }, "flow": { "type": "boolean" },
        "edgeAt": { "type": "number" }, "edgeDur": { "type": "number" }, "flowAt": { "type": "number" }, "r": { "type": "number" }
      }
    },
    "grid": {
      "properties": {
        "preset": { "enum": ["matmul", "tensor"] },
        "n": { "type": "integer" }, "names": { "type": "array" }, "sweepAt": { "type": "number" }, "sweep": { "type": "number" }, "counter": { "type": "boolean" },
        "rows": { "type": "integer" }, "cols": { "type": "integer" },
        "cells": { "type": "array", "description": "grid: [row, col, tone?]; tensor: [i, j, k, tone?]" },
        "values": { "type": "array" }, "blocks": { "type": "array" }, "caption": { "type": "string" }, "stagger": { "type": "number" },
        "dims": { "type": "array", "items": { "type": "integer" } }, "axes": { "type": "array" }, "yaw": { "type": "number" }, "spin": { "type": "boolean" }
      }
    },
    "plot": {
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "array" }, "y": { "type": "array" }, "xticks": { "type": "array" }, "yticks": { "type": "array" }, "xlabel": { "type": "string" }, "ylabel": { "type": "string" },
        "curves": { "type": "array", "items": { "type": "object", "required": ["f"], "properties": { "f": { "type": "string", "description": "JS expression in x; Math functions in scope (log, exp, sqrt, pow, ...)" }, "label": { "type": "string" }, "tone": { "$ref": "#/$defs/tone" }, "dash": { "type": "boolean" }, "at": { "type": "number" }, "dur": { "type": "number" }, "from": { "type": "number" }, "to": { "type": "number" } } } },
        "regions": { "type": "array" }, "asymptotes": { "type": "array" }, "points": { "type": "array" }
      }
    },
    "shape": { "properties": { "shapes": { "type": "array", "items": { "type": "object", "properties": { "kind": { "enum": ["polygon", "regular", "circle", "ellipse", "superellipse"] }, "points": { "type": "array" }, "morph": { "type": "object" } } } }, "points": { "type": "array" }, "axes": { "type": "boolean" }, "scale": { "type": "number" } } },
    "venn": { "required": ["sets"], "properties": { "sets": { "type": "array", "minItems": 2, "maxItems": 3 }, "regions": { "type": "array" }, "members": { "type": "array" } } },
    "sequence": { "required": ["items"], "properties": { "items": { "type": "array" }, "marks": { "type": "object" }, "perRow": { "type": "integer" }, "ellipsis": { "type": "boolean" }, "index": { "type": "string" }, "caption": { "type": "string" } } },
    "equation": { "required": ["lines"], "properties": { "lines": { "type": "array", "items": { "type": "object", "required": ["tex"] } }, "mode": { "enum": ["stack", "replace"] } } },
    "tree": { "required": ["nodes"], "properties": { "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "parent": { "type": "string" }, "status": { "enum": ["lean", "paper", "prior"] } } } }, "legend": { "type": "boolean" } } }
  }
}
