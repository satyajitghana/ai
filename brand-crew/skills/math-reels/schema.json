{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.thesatyajit.com/schemas/math-reel.json",
  "title": "Math reel spec",
  "description": "One 15-20 s reel per openai/math result family, at data/math-reels/<id>.json. Contract and authoring guide: brand-crew/skills/math-reels/SKILL.md. Rich text fields accept $TeX$, ==accent== and **bold**; anything that is not Latin text goes inside $...$.",
  "type": "object",
  "required": [
    "id",
    "discipline",
    "kind",
    "short",
    "title",
    "object",
    "achievement",
    "verify",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "Family number, three digits; also the file name."
    },
    "discipline": {
      "enum": [
        "Number theory",
        "Algebraic and complex geometry",
        "Real and complex analysis",
        "Convex and metric geometry",
        "Theoretical computer science",
        "Dynamical systems and ergodic theory",
        "Combinatorics",
        "Algebra",
        "Probability and statistical mechanics",
        "Mathematical logic",
        "Group theory",
        "Mathematical physics",
        "Operator algebras",
        "Topology",
        "Functional analysis",
        "Differential geometry",
        "Partial differential equations"
      ],
      "description": "Exactly the catalogue's discipline; sets the accent colour."
    },
    "kind": {
      "enum": [
        "proof",
        "disproof",
        "counterexample",
        "improved-bound",
        "partial",
        "conditional"
      ],
      "description": "Shown as 'Claimed proof', 'Claimed improved bound', ..."
    },
    "short": {
      "type": "string",
      "maxLength": 80,
      "description": "Rich text, at most 44 visible characters: the name in the top bar of every scene after the title."
    },
    "title": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 2,
          "maximum": 3,
          "default": 2.6
        },
        "title": {
          "type": "string",
          "description": "Rich text, at most 64 visible characters, two lines at 60 px."
        },
        "subtitle": {
          "type": "string",
          "description": "Rich text, at most 110 visible characters. Starts with 'Claim:' when it states the result."
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": true,
      "description": "The mathematical object, 6-9 s. Either one primitive's parameters inline (primitive: ...) or panels[] of 1-3 primitives.",
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 6,
          "maximum": 9,
          "default": 8
        },
        "heading": {
          "type": "string",
          "description": "Optional rich text over the stage, at most 72 visible characters."
        },
        "layout": {
          "enum": [
            "single",
            "split",
            "sequence"
          ],
          "description": "Default: single for one panel, sequence for more."
        },
        "primitive": {
          "$ref": "#/$defs/primitiveName"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "beats": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "at",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "description": "Rich text caption, at most 96 visible characters."
              }
            }
          }
        }
      }
    },
    "achievement": {
      "type": "object",
      "required": [
        "form"
      ],
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 3,
          "maximum": 5,
          "default": 4.4
        },
        "form": {
          "enum": [
            "bound",
            "status"
          ]
        },
        "heading": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/side"
        },
        "after": {
          "$ref": "#/$defs/side"
        },
        "label": {
          "type": "string",
          "description": "status: what the statement was (e.g. 'Conjecture of Erdős (1975)'), at most 72 characters. Rich text ($TeX$ allowed)."
        },
        "statement": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "description": "TeX (no $), one line each."
          }
        },
        "context": {
          "type": "string",
          "description": "status: what was known before, rich text, at most 110 characters."
        },
        "stamp": {
          "enum": [
            "proved",
            "disproved",
            "counterexample",
            "improved",
            "partial",
            "conditional"
          ],
          "description": "Always drawn with 'CLAIMED' above it. Required feel for status; optional for bound."
        },
        "note": {
          "type": "string",
          "description": "One line under it all: the most important qualification. Rich text, at most 80 characters."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "form": {
                "const": "bound"
              }
            }
          },
          "then": {
            "required": [
              "before",
              "after"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "form": {
                "const": "status"
              }
            }
          },
          "then": {
            "required": [
              "statement"
            ]
          }
        }
      ]
    },
    "verify": {
      "type": "object",
      "required": [
        "lean"
      ],
      "additionalProperties": false,
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 2,
          "maximum": 3,
          "default": 2.6
        },
        "lean": {
          "enum": [
            "main",
            "part",
            "none"
          ],
          "description": "Must match the catalogue's l (0 main, 1 part, 2 none)."
        },
        "detail": {
          "type": "string",
          "description": "What exactly is (or is not) formalized, rich text, at most 100 characters."
        },
        "review": {
          "type": "string",
          "default": "Claim, not yet peer-reviewed",
          "description": "The standing caveat; must still say 'claim'."
        },
        "ourCheck": {
          "type": "string",
          "description": "What we did and did not check, at most 80 characters."
        }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 2,
          "default": 1.6
        },
        "path": {
          "type": "string",
          "default": "/articles/openai-math"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "quote"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(article|catalogue|review)",
            "description": "article ... | catalogue ... | review <id>, <field>"
          },
          "quote": {
            "type": "string",
            "description": "Verbatim; check.mjs verifies article and catalogue quotes always, review quotes with --reviews."
          }
        }
      }
    },
    "plain": {
      "type": "string",
      "description": "Optional. One sentence in everyday words with an analogy, no jargon, at most 110 visible characters; shown on top of the object scene. A non-mathematician must be able to follow title -> plain -> proof -> claim."
    },
    "proof": {
      "$ref": "#/$defs/proof"
    },
    "voice": {
      "type": "array",
      "minItems": 1,
      "description": "Optional narration, 40-55 words in all, written as speech (no TeX, no symbols: 'omega is at most nine over four', 'K seven'). Voiced with Kokoro-82M on the render farm; each scene is lengthened to hold its lines (0.3 s lead, 0.15 s between lines, 0.25 s tail), total at most 21 s. Captions (<id>.vtt) come from these lines.",
      "items": {
        "type": "object",
        "required": [
          "scene",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "scene": {
            "enum": [
              "title",
              "object",
              "proof",
              "achievement",
              "verify",
              "end"
            ]
          },
          "text": {
            "type": "string",
            "description": "What is said. Initialisms are spelled for the voice by pronounce.json (FFT -> F F T); captions keep this text."
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "Start, seconds into the scene. Default: 0.3 s, then 0.15 s after the previous line in the same scene."
          }
        }
      }
    }
  },
  "$defs": {
    "primitiveName": {
      "enum": [
        "numberline",
        "graph",
        "grid",
        "plot",
        "shape",
        "venn",
        "sequence",
        "equation",
        "tree"
      ]
    },
    "side": {
      "type": "object",
      "required": [
        "label",
        "tex"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Caps label, e.g. 'Best known, Aug 2026' / 'Claimed, 2 Oct 2026'."
        },
        "tex": {
          "type": "string",
          "description": "TeX without $ delimiters, set at 52/60 px; keep it under ~22 rendered characters."
        },
        "note": {
          "type": "string",
          "description": "Who/where, rich text, at most 80 characters."
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "primitive"
      ],
      "properties": {
        "primitive": {
          "$ref": "#/$defs/primitiveName"
        },
        "from": {
          "type": "number",
          "description": "sequence layout: panel start, seconds into the object scene"
        },
        "until": {
          "type": "number",
          "description": "sequence layout: panel end"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "numberline"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numberline"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "graph"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/graph"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "grid"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/grid"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "plot"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/plot"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "shape"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/shape"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "venn"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/venn"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/sequence"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "equation"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/equation"
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "tree"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tree"
          }
        }
      ]
    },
    "tone": {
      "type": "string",
      "description": "accent|claim|new (the discipline colour), ink, soft, old|mute, faint, ok, warn, bad, hot, cool, or #rrggbb"
    },
    "mark": {
      "type": "object",
      "required": [
        "v"
      ],
      "properties": {
        "v": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "at": {
          "type": "number"
        },
        "side": {
          "enum": [
            "above",
            "below"
          ]
        },
        "style": {
          "enum": [
            "dot",
            "ring"
          ]
        },
        "derived": {
          "type": "string",
          "description": "The formula a non-integer position was computed from, when the decimal itself is not quoted."
        }
      }
    },
    "numberline": {
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "y": {
          "type": "number",
          "description": "axis height as a fraction of the stage, default 0.62"
        },
        "ticks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "required": [
                  "v",
                  "label"
                ]
              }
            ]
          }
        },
        "axisLabel": {
          "type": "string"
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "tone": {
                "$ref": "#/$defs/tone"
              },
              "at": {
                "type": "number"
              },
              "side": {
                "enum": [
                  "above",
                  "below"
                ]
              }
            }
          }
        },
        "slide": {
          "type": "object",
          "required": [
            "from",
            "to",
            "at"
          ],
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "at": {
              "type": "number"
            },
            "dur": {
              "type": "number",
              "default": 1.4
            },
            "label": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "tone": {
              "$ref": "#/$defs/tone"
            },
            "gap": {
              "type": [
                "string",
                "boolean"
              ],
              "description": "Optional rich-text label for the bracket drawn between from and to after the landing (at most 40 visible characters; numbers need a quote). false hides the bracket."
            },
            "gapSide": {
              "enum": [
                "above",
                "below"
              ]
            }
          }
        },
        "zoom": {
          "type": "object",
          "required": [
            "min",
            "max",
            "at"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "at": {
              "type": "number"
            },
            "dur": {
              "type": "number",
              "default": 2
            },
            "counter": {
              "type": "boolean"
            },
            "ticks": {
              "type": "array"
            }
          }
        },
        "arrow": {
          "type": "boolean"
        }
      }
    },
    "graph": {
      "properties": {
        "preset": {
          "enum": [
            "twopage",
            "butterfly",
            "complete"
          ]
        },
        "n": {
          "type": "integer"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "tone": {
                "$ref": "#/$defs/tone"
              },
              "fill": {
                "$ref": "#/$defs/tone"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3
          }
        },
        "crossings": {
          "type": "boolean"
        },
        "counter": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "done": {
              "type": "string"
            }
          }
        },
        "labels": {
          "type": "boolean"
        },
        "colours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tone"
          }
        },
        "inLabel": {
          "type": "string"
        },
        "outLabel": {
          "type": "string"
        },
        "highlight": {
          "type": "string"
        },
        "flow": {
          "type": "boolean"
        },
        "edgeAt": {
          "type": "number"
        },
        "edgeDur": {
          "type": "number"
        },
        "flowAt": {
          "type": "number"
        },
        "r": {
          "type": "number"
        }
      }
    },
    "grid": {
      "properties": {
        "preset": {
          "enum": [
            "matmul",
            "tensor"
          ]
        },
        "n": {
          "type": "integer"
        },
        "names": {
          "type": "array"
        },
        "sweepAt": {
          "type": "number"
        },
        "sweep": {
          "type": "number"
        },
        "counter": {
          "type": "boolean"
        },
        "rows": {
          "type": "integer"
        },
        "cols": {
          "type": "integer"
        },
        "cells": {
          "type": "array",
          "description": "grid: [row, col, tone?]; tensor: [i, j, k, tone?]"
        },
        "values": {
          "type": "array"
        },
        "blocks": {
          "type": "array"
        },
        "caption": {
          "type": "string"
        },
        "stagger": {
          "type": "number"
        },
        "dims": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "axes": {
          "type": "array"
        },
        "yaw": {
          "type": "number"
        },
        "spin": {
          "type": "boolean"
        }
      }
    },
    "plot": {
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "array"
        },
        "y": {
          "type": "array"
        },
        "xticks": {
          "type": "array"
        },
        "yticks": {
          "type": "array"
        },
        "xlabel": {
          "type": "string"
        },
        "ylabel": {
          "type": "string"
        },
        "curves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "f"
            ],
            "properties": {
              "f": {
                "type": "string",
                "description": "JS expression in x; Math functions in scope (log, exp, sqrt, pow, ...)"
              },
              "label": {
                "type": "string"
              },
              "tone": {
                "$ref": "#/$defs/tone"
              },
              "dash": {
                "type": "boolean"
              },
              "at": {
                "type": "number"
              },
              "dur": {
                "type": "number"
              },
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              }
            }
          }
        },
        "regions": {
          "type": "array"
        },
        "asymptotes": {
          "type": "array"
        },
        "points": {
          "type": "array"
        }
      }
    },
    "shape": {
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "polygon",
                  "regular",
                  "circle",
                  "ellipse",
                  "superellipse"
                ]
              },
              "points": {
                "type": "array"
              },
              "morph": {
                "type": "object"
              }
            }
          }
        },
        "points": {
          "type": "array"
        },
        "axes": {
          "type": "boolean"
        },
        "scale": {
          "type": "number"
        }
      }
    },
    "venn": {
      "required": [
        "sets"
      ],
      "properties": {
        "sets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3
        },
        "regions": {
          "type": "array"
        },
        "members": {
          "type": "array"
        }
      }
    },
    "sequence": {
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array"
        },
        "marks": {
          "type": "object"
        },
        "perRow": {
          "type": "integer"
        },
        "ellipsis": {
          "type": "boolean"
        },
        "index": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "equation": {
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tex"
            ],
            "properties": {
              "tex": {
                "type": "string",
                "description": "Display TeX. Tag parts with \\term{name}{...} to colour, label, point at or visualise them."
              },
              "note": {
                "type": "string"
              },
              "tone": {
                "$ref": "#/$defs/tone"
              },
              "at": {
                "type": "number"
              },
              "size": {
                "type": "number"
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Optional vertical position in the stage (0 top, 1 bottom), to make room for term visuals."
              },
              "terms": {
                "type": "object",
                "description": "Equation visualiser: per tagged term.",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "tone": {
                      "$ref": "#/$defs/tone"
                    },
                    "label": {
                      "type": "string",
                      "description": "Short caption, rich text (e.g. 'error term', 'dimension $n$')."
                    },
                    "mark": {
                      "enum": [
                        "brace",
                        "box",
                        "arrow"
                      ],
                      "default": "brace"
                    },
                    "side": {
                      "enum": [
                        "below",
                        "above"
                      ],
                      "default": "below"
                    },
                    "at": {
                      "type": "number",
                      "description": "Seconds after the line appears; default 0.9 + 0.7 per term."
                    },
                    "size": {
                      "type": "number"
                    },
                    "visual": {
                      "type": "object",
                      "description": "Mini visual under the caption, joined by a leader line; tagged 'illustrative' unless illustrative: false.",
                      "properties": {
                        "kind": {
                          "enum": [
                            "curve",
                            "line",
                            "shape",
                            "graph",
                            "dots",
                            "bar"
                          ]
                        },
                        "dx": {
                          "type": "number",
                          "description": "Horizontal offset of the visual from its term (px)."
                        },
                        "dy": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number",
                          "default": 170
                        },
                        "h": {
                          "type": "number",
                          "default": 84
                        },
                        "f": {
                          "type": "string"
                        },
                        "x": {
                          "type": "array"
                        },
                        "y": {
                          "type": "array"
                        },
                        "ref": {
                          "type": "number"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "marks": {
                          "type": "array"
                        },
                        "shape": {
                          "type": "string"
                        },
                        "n": {
                          "type": "number"
                        },
                        "edges": {
                          "type": "array"
                        },
                        "mark": {
                          "type": "array"
                        },
                        "v": {
                          "type": "number"
                        },
                        "tone": {
                          "$ref": "#/$defs/tone"
                        },
                        "label": {
                          "type": "string"
                        },
                        "illustrative": {
                          "type": "boolean",
                          "default": true
                        }
                      }
                    }
                  }
                }
              },
              "relation": {
                "type": "object",
                "description": "Animate what the line says. lt/le/gt/ge: the left side as a bar that shrinks (grows) past the right; eq: two bars merging; sub: tagged term slides out for tex.",
                "properties": {
                  "kind": {
                    "enum": [
                      "lt",
                      "le",
                      "gt",
                      "ge",
                      "eq",
                      "sub"
                    ]
                  },
                  "at": {
                    "type": "number"
                  },
                  "dy": {
                    "type": "number"
                  },
                  "left": {
                    "type": "object",
                    "properties": {
                      "v": {
                        "type": "number"
                      },
                      "from": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string"
                      },
                      "tone": {
                        "$ref": "#/$defs/tone"
                      }
                    }
                  },
                  "right": {
                    "type": "object",
                    "properties": {
                      "v": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string"
                      },
                      "tone": {
                        "$ref": "#/$defs/tone"
                      }
                    }
                  },
                  "term": {
                    "type": "string"
                  },
                  "tex": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "tone": {
                    "$ref": "#/$defs/tone"
                  },
                  "illustrative": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "mode": {
          "enum": [
            "stack",
            "replace"
          ]
        }
      }
    },
    "tree": {
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "lean",
                  "paper",
                  "prior"
                ]
              }
            }
          }
        },
        "legend": {
          "type": "boolean"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "archetype",
        "steps"
      ],
      "additionalProperties": false,
      "description": "Optional scene between object and achievement: the key idea of the proof, labelled \"How it's proved (simplified)\". The idea must come from the review's explainer/claim or the paper's own proof overview; if it cannot be stated honestly, leave the scene out. With a proof the scene defaults become title 2.5, object 6, proof 5.5, achievement 3.5, verify 2, end 1.2 and the total may reach 21 s.",
      "properties": {
        "dur": {
          "type": "number",
          "minimum": 5,
          "maximum": 6,
          "default": 5.5
        },
        "label": {
          "type": "string",
          "description": "Header override; default \"How it's proved\"."
        },
        "archetype": {
          "enum": [
            "counterexample",
            "construction",
            "squeeze",
            "amplify",
            "reduction",
            "contradiction",
            "induction",
            "probabilistic",
            "monotone",
            "counting",
            "correspondence",
            "local-to-global",
            "cancellation",
            "rearrange"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "at": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "description": "2-4 plain-language captions, at most 72 (aim 60) visible characters each; step k also starts stage k of the archetype's animation."
        },
        "data": {
          "type": "object",
          "description": "Archetype parameters (all optional; labels are rich text, plain words by default). counterexample: items, breakAt, label, labels[], caption. construction: pieces[{label, role, tone}], result. squeeze: min, max, lower{v, from, label, tone}, upper{...}, lowerStep, upperStep, target{v, label}. amplify: k, levels, unit, label. reduction: boxes[], arrow. contradiction: assume, smaller, impossible. induction: levels, labels[], base, var, step. probabilistic: samples, threshold, mean, thresholdLabel, label. monotone: floor, label, floorLabel, ylabel. counting: boxes, items, overflowInto, label, boxLabel. correspondence: left[], right[], pairs[[i, j]], leftTitle, rightTitle, label. local-to-global: cols, rows, patchLabel, label. cancellation: tex (with \\term tags), cancel[[a, b]], result (TeX), label, size. rearrange: pieces, to ('column' | 'square'), label. Every archetype except cancellation is tagged 'illustrative' unless illustrative: false."
        }
      }
    }
  }
}